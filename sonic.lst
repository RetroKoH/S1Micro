    4862/    6F98 : 2C99                		move.l	(a1)+,(a6)	; Write top two tiles
    4863/    6F9A : D087                		add.l	d7,d0		; Next row
    4864/    6F9C : 2A80                		move.l	d0,(a5)
    4865/    6F9E : 2C99                		move.l	(a1)+,(a6)	; Write bottom two tiles
    4866/    6FA0 : 4E75                		rts	
