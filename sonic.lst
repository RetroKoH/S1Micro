    4990/    704E :                     		; Floor the coordinates to the nearest pair of tiles (the size of a block).
    4991/    704E :                     		; Also note that this wraps the value to the size of the plane:
    4992/    704E :                     		; The plane is 64*8 wide, so wrap at $100, and it's 32*8 tall, so wrap at $200
    4993/    704E : 0244 00F0           		andi.w	#$F0,d4
    4994/    7052 : 0245 01F0           		andi.w	#$1F0,d5
    4995/    7056 :                     		; Transform the adjusted coordinates into a VDP command
    4996/    7056 : E94C                		lsl.w	#4,d4
    4997/    7058 : E44D                		lsr.w	#2,d5
    4998/    705A : D845                		add.w	d5,d4
    4999/    705C : 7003                		moveq	#3,d0	; Highest bits of plane VRAM address
    5000/    705E : 4840                		swap	d0
    5001/    7060 : 3004                		move.w	d4,d0
    5002/    7062 : 4E75                		rts	
    5003/    7064 :                     ; End of function Calc_VRAM_Pos
