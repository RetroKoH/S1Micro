     251/       7 : 21 26 00            		ld	hl,zStartupCodeEndLoc	; initial source address
     252/       A : F9                  		ld	sp,hl	; set the address the stack starts at
     253/       B : 77                  		ld	(hl),a	; set first byte of the stack to 0
     254/       C : ED B0               		ldir		; loop to fill the stack (entire remaining available Z80 RAM) with 0
     255/       E : DD E1               		pop	ix	; clear ix
     256/      10 : FD E1               		pop	iy	; clear iy
     257/      12 : ED 47               		ld	i,a	; clear i
