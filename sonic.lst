    4975/    7048 :                     
    4976/    7048 :                     ; Produces a VRAM plane access command from coordinates
    4977/    7048 :                     ; Parameters:
    4978/    7048 :                     ; d4 = Relative Y coordinate
    4979/    7048 :                     ; d5 = Relative X coordinate
    4980/    7048 :                     ; Returns VDP command in d0
