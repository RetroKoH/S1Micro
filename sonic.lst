(1)    9/    D784 : 4CA8 0005 0010      		movem.w	obVelX(a0),d0/d2	; load horizontal speed (d0) and vertical speed (d2)
(1)   10/    D78A : E188                		lsl.l	#8,d0				; multiply by $100 (combine ext and asl to become lsl)
(1)   11/    D78C : D1A8 0008           		add.l	d0,obX(a0)			; apply to x-axis position
