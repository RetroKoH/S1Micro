    4890/    7028 :                     
    4891/    7028 :                     ; Produces a VRAM plane access command from coordinates
    4892/    7028 :                     ; Parameters:
    4893/    7028 :                     ; d4 = Relative Y coordinate
    4894/    7028 :                     ; d5 = Relative X coordinate
    4895/    7028 :                     ; Returns VDP command in d0
    4896/    7028 :                     Calc_VRAM_Pos:
    4901/    7028 : DA53                			add.w	(a3),d5
    4902/    702A :                     Calc_VRAM_Pos_2:
    4903/    702A : D86B 0004           			add.w	4(a3),d4
    4905/    702E :                     		; Floor the coordinates to the nearest pair of tiles (the size of a block).
    4906/    702E :                     		; Also note that this wraps the value to the size of the plane:
    4907/    702E :                     		; The plane is 64*8 wide, so wrap at $100, and it's 32*8 tall, so wrap at $200
    4908/    702E : 0244 00F0           		andi.w	#$F0,d4
    4909/    7032 : 0245 01F0           		andi.w	#$1F0,d5
    4910/    7036 :                     		; Transform the adjusted coordinates into a VDP command
    4911/    7036 : E94C                		lsl.w	#4,d4
    4912/    7038 : E44D                		lsr.w	#2,d5
    4913/    703A : D845                		add.w	d5,d4
    4914/    703C : 7003                		moveq	#3,d0	; Highest bits of plane VRAM address
    4915/    703E : 4840                		swap	d0
    4916/    7040 : 3004                		move.w	d4,d0
    4917/    7042 : 4E75                		rts	
    4918/    7044 :                     ; End of function Calc_VRAM_Pos
    4919/    7044 :                     
    4920/    7044 :                     
    4921/    7044 :                     ; ||||||||||||||| S U B R O U T I N E |||||||||||||||||||||||||||||||||||||||
    4922/    7044 :                     ; not used
    4923/    7044 :                     
    4924/    7044 :                     ; This is just like Calc_VRAM_Pos, but seemingly for an earlier
    4925/    7044 :                     ; VRAM layout: the only difference is the high bits of the
    4926/    7044 :                     ; plane's VRAM address, which are 10 instead of 11.
    4927/    7044 :                     ; Both the foreground and background are at $C000 and $E000
    4928/    7044 :                     ; respectively, so this one starting at $8000 makes no sense.
    4929/    7044 :                     ; sub_6C3C:
    4930/    7044 :                     Calc_VRAM_Pos_Unknown:
    4931/    7044 : D86B 0004           		add.w	4(a3),d4
    4932/    7048 : DA53                		add.w	(a3),d5
    4933/    704A : 0244 00F0           		andi.w	#$F0,d4
    4934/    704E : 0245 01F0           		andi.w	#$1F0,d5
    4935/    7052 : E94C                		lsl.w	#4,d4
    4936/    7054 : E44D                		lsr.w	#2,d5
    4937/    7056 : D845                		add.w	d5,d4
    4938/    7058 : 7002                		moveq	#2,d0
    4939/    705A : 4840                		swap	d0
    4940/    705C : 3004                		move.w	d4,d0
    4941/    705E : 4E75                		rts	
    4942/    7060 :                     ; End of function Calc_VRAM_Pos_Unknown
