     274/       B : 77                  		ld	(hl),a	; set first byte of the stack to 0
     275/       C : ED B0               		ldir		; loop to fill the stack (entire remaining available Z80 RAM) with 0
     276/       E : DD E1               		pop	ix	; clear ix
