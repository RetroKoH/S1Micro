(2)   44/   72070 : =$C9..$CE            	nextenum	nC6=nBs5,nCs6,nDb6=nCs6,nD6,nDs6,nEb6=nDs6,nE6,nFb6=nE6,nEs6,nF6=nEs6
(2)   45/   72070 : =$CF..$D5            	nextenum	nFs6,nGb6=nFs6,nG6,nGs6,nAb6=nGs6,nA6,nAs6,nBb6=nAs6,nB6,nCb7=nB6,nBs6
(2)   46/   72070 : =$D5..$DA            	nextenum	nC7=nBs6,nCs7,nDb7=nCs7,nD7,nDs7,nEb7=nDs7,nE7,nFb7=nE7,nEs7,nF7=nEs7
(2)   47/   72070 : =$DB..$DF            	nextenum	nFs7,nGb7=nFs7,nG7,nGs7,nAb7=nGs7,nA7,nAs7,nBb7=nAs7
(2)   48/   72070 :                     ; SMPS2ASM uses nMaxPSG for songs from S1/S2 drivers.
(2)   49/   72070 :                     ; nMaxPSG1 and nMaxPSG2 are used only for songs from S3/S&K/S3D drivers.
(2)   50/   72070 :                     ; The use of psgdelta is intended to undo the effects of PSGPitchConvert
(2)   51/   72070 :                     ; and ensure that the ending note is indeed the maximum PSG frequency.
(2)   53/   72070 : =$C6                 nMaxPSG				EQU nA5
(2)   54/   72070 : =$D2                 nMaxPSG1			EQU nA5+psgdelta
(2)   55/   72070 : =$D2                 nMaxPSG2			EQU nA5+psgdelta
(2)   61/   72070 :                     ; ---------------------------------------------------------------------------
(2)   62/   72070 :                     ; PSG volume envelope equates
(2)   65/   72070 : =$1..$6              			enum		fTone_01=$01,fTone_02,fTone_03,fTone_04,fTone_05,fTone_06
(2)   66/   72070 : =$7..$9              			nextenum	fTone_07,fTone_08,fTone_09
(2)   86/   72070 :                     ; ---------------------------------------------------------------------------
(2)   87/   72070 :                     ; DAC Equates
(2)   90/   72070 : =$81..$83            			enum		dKick=$81,dSnare,dTimpani
(2)   91/   72070 : =$88..$8B            			enum		dHiTimpani=$88,dMidTimpani,dLowTimpani,dVLowTimpani
(2)  169/   72070 :                     ; ---------------------------------------------------------------------------
(2)  170/   72070 :                     ; Channel IDs for SFX
(2)  171/   72070 : =$80                 cPSG1				EQU $80
(2)  172/   72070 : =$A0                 cPSG2				EQU $A0
(2)  173/   72070 : =$C0                 cPSG3				EQU $C0
(2)  174/   72070 : =$E0                 cNoise				EQU $E0	; Not for use in S3/S&K/S3D
(2)  175/   72070 : =$2                  cFM3				EQU $02
(2)  176/   72070 : =$4                  cFM4				EQU $04
(2)  177/   72070 : =$5                  cFM5				EQU $05
(2)  178/   72070 : =$6                  cFM6				EQU $06	; Only in S3/S&K/S3D, overrides DAC
(2)  179/   72070 :                     ; ---------------------------------------------------------------------------
(2)  180/   72070 :                     ; Conversion macros and functions
(2)  181/   72070 :                     
(2)  182/   72070 :                     conv0To256  function n,((n==0)<<8)|n
(2)  183/   72070 :                     s2TempotoS1 function n,(((768-n)>>1)/(256-n))&$FF
(2)  184/   72070 :                     s2TempotoS3 function n,($100-((n==0)|n))&$FF
(2)  185/   72070 :                     s1TempotoS2 function n,((((conv0To256(n)-1)<<8)+(conv0To256(n)>>1))/conv0To256(n))&$FF
(2)  186/   72070 :                     s1TempotoS3 function n,s2TempotoS3(s1TempotoS2(n))
(2)  187/   72070 :                     s3TempotoS1 function n,s2TempotoS1(s2TempotoS3(n))
(2)  188/   72070 :                     s3TempotoS2 function n,s2TempotoS3(n)
(2)  189/   72070 :                     
(2)  190/   72070 :                     convertMainTempoMod macro mod
(2)  191/   72070 :                     	if ((SourceDriver>=3)&&(SonicDriverVer>=3))||(SonicDriverVer==SourceDriver)
(2)  192/   72070 :                     		dc.b	mod
(2)  193/   72070 :                     	elseif SourceDriver==1
(2)  194/   72070 :                     		if mod==1
(2)  195/   72070 :                     			fatal "Invalid main tempo of 1 in song from Sonic 1"
(2)  196/   72070 :                     		endif
(2)  197/   72070 :                     		if SonicDriverVer==2
(2)  198/   72070 :                     			dc.b	s1TempotoS2(mod)
(2)  199/   72070 :                     		else;if SonicDriverVer>=3
(2)  200/   72070 :                     			dc.b	s1TempotoS3(mod)
(2)  201/   72070 :                     		endif
(2)  202/   72070 :                     	elseif SourceDriver==2
(2)  203/   72070 :                     		if mod==0
(2)  204/   72070 :                     			fatal "Invalid main tempo of 0 in song from Sonic 2"
(2)  205/   72070 :                     		endif
(2)  206/   72070 :                     		if SonicDriverVer==1
(2)  207/   72070 :                     			dc.b	s2TempotoS1(mod)
(2)  208/   72070 :                     		else;if SonicDriverVer>=3
(2)  209/   72070 :                     			dc.b	s2TempotoS3(mod)
(2)  210/   72070 :                     		endif
(2)  211/   72070 :                     	else;if SourceDriver>=3
(2)  212/   72070 :                     		if mod==0
(2)  213/   72070 :                     			message "Performing approximate conversion of Sonic 3 main tempo modifier of 0"
(2)  214/   72070 :                     		endif
(2)  215/   72070 :                     		if SonicDriverVer==1
(2)  216/   72070 :                     			dc.b	s3TempotoS1(mod)
(2)  217/   72070 :                     		else;if SonicDriverVer==2
(2)  218/   72070 :                     			dc.b	s3TempotoS2(mod)
(2)  219/   72070 :                     		endif
(2)  220/   72070 :                     	endif
(2)  221/   72070 :                     	endm
(2)  222/   72070 :                     
(2)  223/   72070 :                     ; PSG conversion to S3/S&K/S3D drivers require a tone shift of 12 semi-tones.
(2)  224/   72070 :                     PSGPitchConvert macro pitch
(2)  225/   72070 :                     	if (SonicDriverVer>=3)&&(SourceDriver<3)
(2)  226/   72070 :                     		dc.b	(pitch+psgdelta)&$FF
(2)  227/   72070 :                     	elseif (SonicDriverVer<3)&&(SourceDriver>=3)
(2)  228/   72070 :                     		dc.b	(pitch-psgdelta)&$FF
(2)  229/   72070 :                     	else
(2)  230/   72070 :                     		dc.b	pitch
(2)  231/   72070 :                     	endif
(2)  232/   72070 :                     	endm
(2)  233/   72070 :                     
(2)  234/   72070 :                     CheckedChannelPointer macro loc
(2)  235/   72070 :                     	if SonicDriverVer<>1
(2)  236/   72070 :                     		dc.w	z80_ptr(loc)
(2)  237/   72070 :                     	else
(2)  238/   72070 :                     		if (MOMPASS=1)&&(DEFINED(loc))
(2)  239/   72070 :                     			fatal "Tracks for Sonic 1 songs must come after the start of the song"
(2)  240/   72070 :                     		endif
(2)  241/   72070 :                     		dc.w	loc-songStart
(2)  242/   72070 :                     	endif
(2)  243/   72070 :                     	endm
(2)  244/   72070 :                     ; ---------------------------------------------------------------------------
(2)  245/   72070 :                     ; Header Macros
(2)  246/   72070 :                     smpsHeaderStartSong macro ver, sourcesmps2asmver
(2)  247/   72070 :                     
(2)  248/   72070 :                     SourceDriver set ver
(2)  249/   72070 :                     
(2)  250/   72070 :                     	if ("sourcesmps2asmver"<>"")
(2)  251/   72070 :                     		set SourceSMPS2ASM,sourcesmps2asmver
(2)  252/   72070 :                     	else
(2)  253/   72070 :                     		set SourceSMPS2ASM,0
(2)  254/   72070 :                     	endif
(2)  255/   72070 :                     
(2)  256/   72070 :                     songStart set *
(2)  257/   72070 :                     
(2)  258/   72070 :                     	if MOMPASS=1
(2)  259/   72070 :                     		if SMPS2ASMVer < SourceSMPS2ASM
(2)  260/   72070 :                     			message "Song at 0x\{songStart} was made for a newer version of SMPS2ASM (this is version \{SMPS2ASMVer}, but song wants at least version \{SourceSMPS2ASM})."
(2)  261/   72070 :                     		endif
(2)  262/   72070 :                     	endif
(2)  263/   72070 :                     
(2)  264/   72070 :                     	endm
(2)  265/   72070 :                     
(2)  266/   72070 :                     smpsHeaderVoiceNull macro
(2)  267/   72070 :                     	if songStart<>*
(2)  268/   72070 :                     		fatal "Missing smpsHeaderStartSong"
(2)  269/   72070 :                     	endif
(2)  270/   72070 :                     	dc.w	$0000
(2)  271/   72070 :                     	endm
(2)  272/   72070 :                     
(2)  273/   72070 :                     ; Header - Set up Voice Location
(2)  274/   72070 :                     ; Common to music and SFX
(2)  275/   72070 :                     smpsHeaderVoice macro loc
(2)  276/   72070 :                     	if songStart<>*
(2)  277/   72070 :                     		fatal "Missing smpsHeaderStartSong"
(2)  278/   72070 :                     	endif
(2)  279/   72070 :                     	if SonicDriverVer<>1
(2)  280/   72070 :                     		dc.w	z80_ptr(loc)
(2)  281/   72070 :                     	else
(2)  282/   72070 :                     		if (MOMPASS=1)&&(DEFINED(loc))
(2)  283/   72070 :                     			fatal "Voice banks for Sonic 1 songs must come after the start of the song"
(2)  284/   72070 :                     		endif
(2)  285/   72070 :                     		dc.w	loc-songStart
(2)  286/   72070 :                     	endif
(2)  287/   72070 :                     	endm
(2)  288/   72070 :                     
(2)  289/   72070 :                     ; Header - Set up Voice Location as S3's Universal Voice Bank
(2)  290/   72070 :                     ; Common to music and SFX
(2)  291/   72070 :                     smpsHeaderVoiceUVB macro
(2)  292/   72070 :                     	if songStart<>*
(2)  293/   72070 :                     		fatal "Missing smpsHeaderStartSong"
(2)  294/   72070 :                     	endif
(2)  295/   72070 :                     	if SonicDriverVer>=5
(2)  296/   72070 :                     		dc.w	z80_ptr(z80_UniVoiceBank)
(2)  297/   72070 :                     	elseif SonicDriverVer>=3
(2)  298/   72070 :                     		dc.w	little_endian(z80_UniVoiceBank)
(2)  299/   72070 :                     	else
(2)  300/   72070 :                     		fatal "Universal Voice Bank does not exist in Sonic 1 or Sonic 2 drivers"
(2)  301/   72070 :                     	endif
(2)  302/   72070 :                     	endm
(2)  303/   72070 :                     
