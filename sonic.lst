(1) 2627/   71F7C :                     
(1) 2628/   71F7C :                     ; ---------------------------------------------------------------------------
(1) 2629/   71F7C :                     ; SMPS2ASM - A collection of macros that make SMPS's bytecode human-readable.
(1) 2630/   71F7C :                     ; ---------------------------------------------------------------------------
(1) 2631/   71F7C : =$0                  FixMusicAndSFXDataBugs = FixBugs
(1) 2632/   71F7C : =$1                  SonicDriverVer = 1 ; Tell SMPS2ASM that we're using Sonic 1's driver.
(1) 2633/   71F7C :                     		include "sound/_smps2asm_inc.asm"
