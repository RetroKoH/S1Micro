(2)  502/   72070 :                     ; ECxx - Set Volume to xx
(2)  503/   72070 :                     smpsSetVol macro val
(2)  504/   72070 :                     	if SonicDriverVer>=3
(2)  505/   72070 :                     		dc.b	$E4,val
(2)  506/   72070 :                     	else
(2)  507/   72070 :                     		fatal "Coord. Flag to set volume (instead of volume attenuation) does not exist in S1 or S2 drivers. Complain to Flamewing to add it."
(2)  508/   72070 :                     	endif
(2)  509/   72070 :                     	endm
(2)  510/   72070 :                     
(2)  511/   72070 :                     ; Works on all drivers
(2)  512/   72070 :                     smpsPSGAlterVol macro vol
(2)  513/   72070 :                     	dc.b	$EC,vol
(2)  514/   72070 :                     	endm
(2)  515/   72070 :                     
(2)  516/   72070 :                     smpsPSGAlterVolS2 macro vol
(2)  517/   72070 :                     	; Sonic 2's driver allows the FM command to be used on PSG channels, but others do not.
(2)  518/   72070 :                     	if SonicDriverVer==2
(2)  519/   72070 :                     		smpsAlterVol vol
(2)  520/   72070 :                     	else
(2)  521/   72070 :                     		smpsPSGAlterVol vol
(2)  522/   72070 :                     	endif
(2)  523/   72070 :                     	endm
(2)  524/   72070 :                     
(2)  525/   72070 :                     ; Clears pushing sound flag in S1
(2)  526/   72070 :                     smpsClearPush macro
(2)  527/   72070 :                     	if SonicDriverVer==1
(2)  528/   72070 :                     		dc.b	$ED
(2)  529/   72070 :                     	else
(2)  530/   72070 :                     		fatal "Coord. Flag to clear S1 push block flag does not exist in S2 or S3 drivers. Complain to Flamewing to add it."
(2)  531/   72070 :                     	endif
(2)  532/   72070 :                     	endm
(2)  533/   72070 :                     
(2)  534/   72070 :                     ; Stops special SFX (S1 only) and restarts overridden music track
(2)  535/   72070 :                     smpsStopSpecial macro
(2)  536/   72070 :                     	if SonicDriverVer==1
(2)  537/   72070 :                     		dc.b	$EE
(2)  538/   72070 :                     	else
(2)  539/   72070 :                     		message "Coord. Flag to stop special SFX does not exist in S2 or S3 drivers. Complain to Flamewing to add it. With adequate caution, smpsStop can do this job."
(2)  540/   72070 :                     		smpsStop
(2)  541/   72070 :                     	endif
(2)  542/   72070 :                     	endm
(2)  543/   72070 :                     
(2)  544/   72070 :                     ; EFxx[yy] - Set Voice of FM channel to xx; xx < 0 means yy present
(2)  545/   72070 :                     smpsFMvoice macro voice,songID
(2)  546/   72070 :                     	if (SonicDriverVer>=3)&&("songID"<>"")
(2)  547/   72070 :                     		dc.b	$EF,voice|$80,songID+$81
(2)  548/   72070 :                     	else
(2)  549/   72070 :                     		dc.b	$EF,voice
(2)  550/   72070 :                     	endif
(2)  551/   72070 :                     	endm
(2)  552/   72070 :                     
(2)  553/   72070 :                     ; F0wwxxyyzz - Modulation - ww: wait time - xx: modulation speed - yy: change per step - zz: number of steps
(2)  554/   72070 :                     smpsModSet macro wait,speed,change,step
(2)  555/   72070 :                     	dc.b	$F0
(2)  556/   72070 :                     	if (SonicDriverVer>=3)&&(SourceDriver<3)
(2)  557/   72070 :                     		dc.b	wait+1,speed,change,((step+1) * speed) & $FF
(2)  558/   72070 :                     	elseif (SonicDriverVer<3)&&(SourceDriver>=3)
(2)  559/   72070 :                     		dc.b	wait-1,speed,change,conv0To256(step)/conv0To256(speed)-1
(2)  560/   72070 :                     	else
(2)  561/   72070 :                     		dc.b	wait,speed,change,step
(2)  562/   72070 :                     	endif
(2)  563/   72070 :                     	;dc.b	speed,change,step
(2)  564/   72070 :                     	endm
(2)  565/   72070 :                     
(2)  566/   72070 :                     ; Turn on Modulation
(2)  567/   72070 :                     smpsModOn macro type
(2)  568/   72070 :                     	if SonicDriverVer>=3
(2)  569/   72070 :                     		if "type"<>""
(2)  570/   72070 :                     			dc.b	$F4,type
(2)  571/   72070 :                     		else
(2)  572/   72070 :                     			dc.b	$F4,$80
(2)  573/   72070 :                     		endif
(2)  574/   72070 :                     	else
(2)  575/   72070 :                     		dc.b	$F1
(2)  576/   72070 :                     	endif
(2)  577/   72070 :                     	endm
(2)  578/   72070 :                     
(2)  579/   72070 :                     ; F2 - End of channel
(2)  580/   72070 :                     smpsStop macro
(2)  581/   72070 :                     	dc.b	$F2
(2)  582/   72070 :                     	endm
(2)  583/   72070 :                     
(2)  584/   72070 :                     ; F3xx - PSG waveform to xx
(2)  585/   72070 :                     smpsPSGform macro form
(2)  586/   72070 :                     	dc.b	$F3,form
(2)  587/   72070 :                     	endm
(2)  588/   72070 :                     
(2)  589/   72070 :                     ; Turn off Modulation
(2)  590/   72070 :                     smpsModOff macro
(2)  591/   72070 :                     	if SonicDriverVer>=3
(2)  592/   72070 :                     		dc.b	$FA
(2)  593/   72070 :                     	else
(2)  594/   72070 :                     		dc.b	$F4
(2)  595/   72070 :                     	endif
(2)  596/   72070 :                     	endm
(2)  597/   72070 :                     
(2)  598/   72070 :                     ; F5xx - PSG voice to xx
(2)  599/   72070 :                     smpsPSGvoice macro voice
(2)  600/   72070 :                     	dc.b	$F5,voice
(2)  601/   72070 :                     	endm
(2)  602/   72070 :                     
(2)  603/   72070 :                     ; F6xxxx - Jump to xxxx
(2)  604/   72070 :                     smpsJump macro loc
(2)  605/   72070 :                     	dc.b	$F6
(2)  606/   72070 :                     	if SonicDriverVer<>1
(2)  607/   72070 :                     		dc.w	z80_ptr(loc)
(2)  608/   72070 :                     	else
(2)  609/   72070 :                     		dc.w	loc-*-1
(2)  610/   72070 :                     	endif
(2)  611/   72070 :                     	endm
(2)  612/   72070 :                     
(2)  613/   72070 :                     ; F7xxyyzzzz - Loop back to zzzz yy times, xx being the loop index for loop recursion fixing
(2)  614/   72070 :                     smpsLoop macro index,loops,loc
(2)  615/   72070 :                     	dc.b	$F7
(2)  616/   72070 :                     	dc.b	index,loops
(2)  617/   72070 :                     	if SonicDriverVer<>1
(2)  618/   72070 :                     		dc.w	z80_ptr(loc)
(2)  619/   72070 :                     	else
(2)  620/   72070 :                     		dc.w	loc-*-1
(2)  621/   72070 :                     	endif
(2)  622/   72070 :                     	endm
(2)  623/   72070 :                     
(2)  624/   72070 :                     ; F8xxxx - Call pattern at xxxx, saving return point
(2)  625/   72070 :                     smpsCall macro loc
(2)  626/   72070 :                     	dc.b	$F8
(2)  627/   72070 :                     	if SonicDriverVer<>1
(2)  628/   72070 :                     		dc.w	z80_ptr(loc)
(2)  629/   72070 :                     	else
(2)  630/   72070 :                     		dc.w	loc-*-1
(2)  631/   72070 :                     	endif
(2)  632/   72070 :                     	endm
(2)  633/   72070 :                     ; ---------------------------------------------------------------------------
(2)  634/   72070 :                     ; Alter Volume
(2)  635/   72070 :                     smpsFMAlterVol macro val1,val2
(2)  636/   72070 :                     	if ("val2"<>"")
(2)  637/   72070 :                     		; S3K's nerfed 'PSG & FM volume' command with broken PSG support.
(2)  638/   72070 :                     		; The first value is completely unused, while the second is for FM tracks.
(2)  639/   72070 :                     		if (SonicDriverVer>=3)
(2)  640/   72070 :                     			dc.b	$E5,val1,val2
(2)  641/   72070 :                     		else
(2)  642/   72070 :                     			dc.b	$E6,val2
(2)  643/   72070 :                     		endif
(2)  644/   72070 :                     	else
(2)  645/   72070 :                     		; Normal, sane command.
(2)  646/   72070 :                     		dc.b	$E6,val1
(2)  647/   72070 :                     	endif
(2)  648/   72070 :                     	endm
(2)  649/   72070 :                     
(2)  650/   72070 :                     ; S3/S&K/S3D-only coordination flags
(2)  755/   72070 :                     ; ---------------------------------------------------------------------------
(2)  756/   72070 :                     ; S1/S2 only coordination flag
(2)  757/   72070 :                     ; Sets D1L to maximum volume (minimum attenuation) and RR to maximum for operators 3 and 4 of FM1
(2)  758/   72070 :                     smpsMaxRelRate macro
(2)  759/   72070 :                     	if SonicDriverVer>=3
(2)  760/   72070 :                     		; Emulate it in S3/S&K/S3D driver
(2)  761/   72070 :                     		smpsFMICommand $88,$0F
(2)  762/   72070 :                     		smpsFMICommand $8C,$0F
(2)  763/   72070 :                     	else
(2)  764/   72070 :                     		dc.b	$F9
(2)  765/   72070 :                     	endif
(2)  766/   72070 :                     	endm
(2)  767/   72070 :                     ; ---------------------------------------------------------------------------
(2)  768/   72070 :                     ; Backwards compatibility
(2)  769/   72070 :                     smpsAlterNote macro
(2)  770/   72070 :                     	smpsDetune	ALLARGS
(2)  771/   72070 :                     	endm
(2)  772/   72070 :                     
(2)  773/   72070 :                     smpsAlterPitch macro
(2)  774/   72070 :                     	smpsChangeTransposition	ALLARGS
(2)  775/   72070 :                     	endm
(2)  776/   72070 :                     
(2)  777/   72070 :                     smpsFMFlutter macro
(2)  778/   72070 :                     	smpsFMVolEnv	ALLARGS
(2)  779/   72070 :                     	endm
(2)  780/   72070 :                     
(2)  781/   72070 :                     smpsWeirdD1LRR macro
(2)  782/   72070 :                     	smpsMaxRelRate ALLARGS
(2)  783/   72070 :                     	endm
(2)  784/   72070 :                     
(2)  785/   72070 :                     smpsSetvoice macro
(2)  786/   72070 :                     	smpsFMvoice ALLARGS
(2)  787/   72070 :                     	endm
(2)  788/   72070 :                     ; ---------------------------------------------------------------------------
(2)  789/   72070 :                     ; Macros for FM instruments
(2)  790/   72070 :                     ; Voices - Feedback
(2)  791/   72070 :                     smpsVcFeedback macro val
(2)  792/   72070 :                     vcFeedback eval val
(2)  793/   72070 :                     	endm
(2)  794/   72070 :                     
(2)  795/   72070 :                     ; Voices - Algorithm
(2)  796/   72070 :                     smpsVcAlgorithm macro val
(2)  797/   72070 :                     vcAlgorithm eval val
(2)  798/   72070 :                     	endm
(2)  799/   72070 :                     
(2)  800/   72070 :                     smpsVcUnusedBits macro val,d1r1,d1r2,d1r3,d1r4
(2)  801/   72070 :                     vcUnusedBits eval val
(2)  802/   72070 :                     	if ("d1r1"<>"")&&("d1r2"<>"")&&("d1r3"<>"")&&("d1r4"<>"")
(2)  803/   72070 :                     		eval vcD1R1Unk,d1r1<<5
(2)  804/   72070 :                     		eval vcD1R2Unk,d1r2<<5
(2)  805/   72070 :                     		eval vcD1R3Unk,d1r3<<5
(2)  806/   72070 :                     		eval vcD1R4Unk,d1r4<<5
(2)  807/   72070 :                     	else
(2)  808/   72070 :                     		eval vcD1R1Unk,0
(2)  809/   72070 :                     		eval vcD1R2Unk,0
(2)  810/   72070 :                     		eval vcD1R3Unk,0
(2)  811/   72070 :                     		eval vcD1R4Unk,0
(2)  812/   72070 :                     	endif
(2)  813/   72070 :                     	endm
(2)  814/   72070 :                     
(2)  815/   72070 :                     ; Voices - Detune
(2)  816/   72070 :                     smpsVcDetune macro op1,op2,op3,op4
(2)  817/   72070 :                     	eval vcDT1,op1
(2)  818/   72070 :                     	eval vcDT2,op2
(2)  819/   72070 :                     	eval vcDT3,op3
(2)  820/   72070 :                     	eval vcDT4,op4
(2)  821/   72070 :                     	endm
(2)  822/   72070 :                     
(2)  823/   72070 :                     ; Voices - Coarse-Frequency
(2)  824/   72070 :                     smpsVcCoarseFreq macro op1,op2,op3,op4
(2)  825/   72070 :                     	eval vcCF1,op1
(2)  826/   72070 :                     	eval vcCF2,op2
(2)  827/   72070 :                     	eval vcCF3,op3
(2)  828/   72070 :                     	eval vcCF4,op4
(2)  829/   72070 :                     	endm
(2)  830/   72070 :                     
(2)  831/   72070 :                     ; Voices - Rate Scale
(2)  832/   72070 :                     smpsVcRateScale macro op1,op2,op3,op4
(2)  833/   72070 :                     	eval vcRS1,op1
(2)  834/   72070 :                     	eval vcRS2,op2
(2)  835/   72070 :                     	eval vcRS3,op3
(2)  836/   72070 :                     	eval vcRS4,op4
(2)  837/   72070 :                     	endm
(2)  838/   72070 :                     
(2)  839/   72070 :                     ; Voices - Attack Rate
(2)  840/   72070 :                     smpsVcAttackRate macro op1,op2,op3,op4
(2)  841/   72070 :                     	eval vcAR1,op1
(2)  842/   72070 :                     	eval vcAR2,op2
(2)  843/   72070 :                     	eval vcAR3,op3
(2)  844/   72070 :                     	eval vcAR4,op4
(2)  845/   72070 :                     	endm
(2)  846/   72070 :                     
(2)  847/   72070 :                     ; Voices - Amplitude Modulation
(2)  848/   72070 :                     ; The original SMPS2ASM erroneously assumed the 6th and 7th bits
(2)  849/   72070 :                     ; were the Amplitude Modulation.
(2)  850/   72070 :                     ; According to several docs, however, it's actually the high bit.
(2)  851/   72070 :                     smpsVcAmpMod macro op1,op2,op3,op4
(2)  852/   72070 :                     	if SourceSMPS2ASM==0
(2)  853/   72070 :                     		eval vcAM1,op1<<5
(2)  854/   72070 :                     		eval vcAM2,op2<<5
(2)  855/   72070 :                     		eval vcAM3,op3<<5
(2)  856/   72070 :                     		eval vcAM4,op4<<5
(2)  857/   72070 :                     	else
(2)  858/   72070 :                     		eval vcAM1,op1<<7
(2)  859/   72070 :                     		eval vcAM2,op2<<7
(2)  860/   72070 :                     		eval vcAM3,op3<<7
(2)  861/   72070 :                     		eval vcAM4,op4<<7
(2)  862/   72070 :                     	endif
(2)  863/   72070 :                     	endm
(2)  864/   72070 :                     
(2)  865/   72070 :                     ; Voices - First Decay Rate
(2)  866/   72070 :                     smpsVcDecayRate1 macro op1,op2,op3,op4
(2)  867/   72070 :                     	eval vcD1R1,op1
(2)  868/   72070 :                     	eval vcD1R2,op2
(2)  869/   72070 :                     	eval vcD1R3,op3
(2)  870/   72070 :                     	eval vcD1R4,op4
(2)  871/   72070 :                     	endm
(2)  872/   72070 :                     
(2)  873/   72070 :                     ; Voices - Second Decay Rate
(2)  874/   72070 :                     smpsVcDecayRate2 macro op1,op2,op3,op4
(2)  875/   72070 :                     	eval vcD2R1,op1
(2)  876/   72070 :                     	eval vcD2R2,op2
(2)  877/   72070 :                     	eval vcD2R3,op3
(2)  878/   72070 :                     	eval vcD2R4,op4
(2)  879/   72070 :                     	endm
(2)  880/   72070 :                     
(2)  881/   72070 :                     ; Voices - Decay Level
(2)  882/   72070 :                     smpsVcDecayLevel macro op1,op2,op3,op4
(2)  883/   72070 :                     	eval vcDL1,op1
(2)  884/   72070 :                     	eval vcDL2,op2
(2)  885/   72070 :                     	eval vcDL3,op3
(2)  886/   72070 :                     	eval vcDL4,op4
(2)  887/   72070 :                     	endm
(2)  888/   72070 :                     
(2)  889/   72070 :                     ; Voices - Release Rate
(2)  890/   72070 :                     smpsVcReleaseRate macro op1,op2,op3,op4
(2)  891/   72070 :                     	eval vcRR1,op1
(2)  892/   72070 :                     	eval vcRR2,op2
(2)  893/   72070 :                     	eval vcRR3,op3
(2)  894/   72070 :                     	eval vcRR4,op4
(2)  895/   72070 :                     	endm
(2)  896/   72070 :                     
(2)  897/   72070 :                     smpsNotZ80 function cpu,(cpu<>128)&&(cpu<>32988)
(2)  898/   72070 :                     
(2)  899/   72070 :                     smpsDcb macro
(2)  900/   72070 :                     		if smpsNotZ80(MOMCPU)
(2)  901/   72070 :                     			dc.b ALLARGS
(2)  902/   72070 :                     		else
(2)  903/   72070 :                     			db ALLARGS
(2)  904/   72070 :                     		endif
(2)  905/   72070 :                     	endm
(2)  906/   72070 :                     
(2)  907/   72070 :                     ; Voices - Total Level
(2)  908/   72070 :                     ; The original SMPS2ASM decides TL high bits automatically,
(2)  909/   72070 :                     ; but later versions leave it up to the user.
(2)  910/   72070 :                     ; Alternatively, if we're converting an SMPS 68k song to SMPS Z80,
(2)  911/   72070 :                     ; then we *want* the TL bits to match the algorithm, because SMPS 68k
(2)  912/   72070 :                     ; prefers the algorithm over the TL bits, ignoring the latter, while
(2)  913/   72070 :                     ; SMPS Z80 does the opposite.
(2)  914/   72070 :                     ; Unfortunately, there's nothing we can do if we're trying to convert
(2)  915/   72070 :                     ; an SMPS Z80 song to SMPS 68k. It will ignore the bits no matter
(2)  916/   72070 :                     ; what we do, so we just print a warning.
(2)  917/   72070 :                     smpsVcTotalLevel macro op1,op2,op3,op4
(2)  918/   72070 :                     	eval vcTL1,op1
(2)  919/   72070 :                     	eval vcTL2,op2
(2)  920/   72070 :                     	eval vcTL3,op3
(2)  921/   72070 :                     	eval vcTL4,op4
(2)  922/   72070 :                     	smpsDcb	(vcUnusedBits<<6)+(vcFeedback<<3)+vcAlgorithm
(2)  923/   72070 :                     ;   0     1     2     3     4     5     6     7
(2)  924/   72070 :                     ;%1000,%1000,%1000,%1000,%1010,%1110,%1110,%1111
(2)  925/   72070 :                     	if SourceSMPS2ASM==0
(2)  926/   72070 :                     		eval vcTLMask4,((vcAlgorithm==7)<<7)
(2)  927/   72070 :                     		eval vcTLMask3,((vcAlgorithm>=4)<<7)
(2)  928/   72070 :                     		eval vcTLMask2,((vcAlgorithm>=5)<<7)
(2)  929/   72070 :                     		eval vcTLMask1,128
(2)  930/   72070 :                     	else
(2)  931/   72070 :                     		eval vcTLMask4,0
(2)  932/   72070 :                     		eval vcTLMask3,0
(2)  933/   72070 :                     		eval vcTLMask2,0
(2)  934/   72070 :                     		eval vcTLMask1,0
(2)  935/   72070 :                     	endif
(2)  936/   72070 :                     
(2)  937/   72070 :                     	if (SonicDriverVer>=3)&&(SourceDriver<3)
(2)  938/   72070 :                     		eval vcTLMask4,((vcAlgorithm==7)<<7)
(2)  939/   72070 :                     		eval vcTLMask3,((vcAlgorithm>=4)<<7)
(2)  940/   72070 :                     		eval vcTLMask2,((vcAlgorithm>=5)<<7)
(2)  941/   72070 :                     		eval vcTLMask1,128
(2)  942/   72070 :                     		eval vcTL1,vcTL1&127
(2)  943/   72070 :                     		eval vcTL2,vcTL2&127
(2)  944/   72070 :                     		eval vcTL3,vcTL3&127
(2)  945/   72070 :                     		eval vcTL4,vcTL4&127
(2)  946/   72070 :                     	elseif (SonicDriverVer<3)&&(SourceDriver>=3)&&((((vcTL1|vcTLMask1)&128)<>128)||(((vcTL2|vcTLMask2)&128)<>((vcAlgorithm>=5)<<7))||(((vcTL3|vcTLMask3)&128)<>((vcAlgorithm>=4)<<7))||(((vcTL4|vcTLMask4)&128)<>((vcAlgorithm==7)<<7)))
(2)  947/   72070 :                     		if MOMPASS=1
(2)  948/   72070 :                     			message "Voice at 0x\{*} has TL bits that do not match its algorithm setting. This voice will not work in S1/S2 drivers."
(2)  949/   72070 :                     		endif
(2)  950/   72070 :                     	endif
(2)  951/   72070 :                     
(2)  952/   72070 :                     	if SonicDriverVer==2
(2)  953/   72070 :                     		smpsDcb	(vcDT4<<4)+vcCF4       ,(vcDT2<<4)+vcCF2       ,(vcDT3<<4)+vcCF3       ,(vcDT1<<4)+vcCF1
(2)  954/   72070 :                     		smpsDcb	(vcRS4<<6)+vcAR4       ,(vcRS2<<6)+vcAR2       ,(vcRS3<<6)+vcAR3       ,(vcRS1<<6)+vcAR1
(2)  955/   72070 :                     		smpsDcb	vcAM4|vcD1R4|vcD1R4Unk ,vcAM2|vcD1R2|vcD1R2Unk ,vcAM3|vcD1R3|vcD1R3Unk ,vcAM1|vcD1R1|vcD1R1Unk
(2)  956/   72070 :                     		smpsDcb	vcD2R4                 ,vcD2R2                 ,vcD2R3                 ,vcD2R1
(2)  957/   72070 :                     		smpsDcb	(vcDL4<<4)+vcRR4       ,(vcDL2<<4)+vcRR2       ,(vcDL3<<4)+vcRR3       ,(vcDL1<<4)+vcRR1
(2)  958/   72070 :                     		smpsDcb	vcTL4|vcTLMask4        ,vcTL2|vcTLMask2        ,vcTL3|vcTLMask3        ,vcTL1|vcTLMask1
(2)  959/   72070 :                     	else
