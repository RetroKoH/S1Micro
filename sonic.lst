    4934/    7004 : DA53                			add.w	(a3),d5		; MJ: load X position to d5
    4935/    7006 :                     GetBlockData_2:
    4936/    7006 : D86B 0004           			add.w	4(a3),d4	; MJ: load Y position to d4
