(1)    1/    FA96 :                     ; ---------------------------------------------------------------------------
(1)    2/    FA96 :                     ; Solid object subroutine (includes spikes, blocks, rocks etc)
(1)    3/    FA96 :                     ;
(1)    4/    FA96 :                     ; input:
(1)    5/    FA96 :                     ;	d1 = width
(1)    6/    FA96 :                     ;	d2 = height / 2 (when jumping)
(1)    7/    FA96 :                     ;	d3 = height / 2 (when walking)
(1)    8/    FA96 :                     ;	d4 = x-axis position
(1)    9/    FA96 :                     ; ---------------------------------------------------------------------------
(1)   10/    FA96 :                     
(1)   11/    FA96 :                     ; ||||||||||||||| S U B R O U T I N E |||||||||||||||||||||||||||||||||||||||
(1)   12/    FA96 :                     
(1)   13/    FA96 :                     
(1)   14/    FA96 :                     SolidObject:
(1)   15/    FA96 : 4A28 0025           		tst.b	obSolid(a0)	; is Sonic standing on the object?
(1)   16/    FA9A : 6700 00EC           		beq.w	Solid_ChkEnter	; if not, branch
(1)   17/    FA9E : 3401                		move.w	d1,d2
(1)   18/    FAA0 : D442                		add.w	d2,d2
(1)   19/    FAA2 : 43F8 D000           		lea	(v_player).w,a1
(1)   20/    FAA6 : 0829 0001 0022      		btst	#1,obStatus(a1)	; is Sonic in the air?
(1)   21/    FAAC : 6610                		bne.s	.leave		; if yes, branch
(1)   22/    FAAE : 3029 0008           		move.w	obX(a1),d0
(1)   23/    FAB2 : 9068 0008           		sub.w	obX(a0),d0
