(2)  305/   72070 :                     ; Header - Set up Channel Usage
(2)  306/   72070 :                     smpsHeaderChan macro fm,psg
(2)  307/   72070 :                     	dc.b	fm,psg
(2)  308/   72070 :                     	endm
(2)  309/   72070 :                     
(2)  310/   72070 :                     ; Header - Set up Tempo
(2)  311/   72070 :                     smpsHeaderTempo macro div,mod
(2)  312/   72070 :                     	dc.b	div
(2)  313/   72070 :                     	convertMainTempoMod mod
(2)  314/   72070 :                     	endm
(2)  315/   72070 :                     
(2)  316/   72070 :                     ; Header - Set up DAC Channel
(2)  317/   72070 :                     smpsHeaderDAC macro loc,pitch,vol
(2)  318/   72070 :                     	CheckedChannelPointer loc
(2)  319/   72070 :                     	if ("pitch"<>"")
(2)  320/   72070 :                     		dc.b	pitch
(2)  321/   72070 :                     		if ("vol"<>"")
(2)  322/   72070 :                     			dc.b	vol
(2)  323/   72070 :                     		else
(2)  324/   72070 :                     			dc.b	$00
(2)  325/   72070 :                     		endif
(2)  326/   72070 :                     	else
(2)  327/   72070 :                     		dc.w	$00
(2)  328/   72070 :                     	endif
(2)  329/   72070 :                     	endm
(2)  330/   72070 :                     
(2)  331/   72070 :                     ; Header - Set up FM Channel
(2)  332/   72070 :                     smpsHeaderFM macro loc,pitch,vol
(2)  333/   72070 :                     	CheckedChannelPointer loc
(2)  334/   72070 :                     	dc.b	pitch,vol
(2)  335/   72070 :                     	endm
(2)  336/   72070 :                     
(2)  337/   72070 :                     ; Header - Set up PSG Channel
(2)  338/   72070 :                     smpsHeaderPSG macro loc,pitch,vol,mod,voice
(2)  339/   72070 :                     	CheckedChannelPointer loc
(2)  340/   72070 :                     	PSGPitchConvert pitch
(2)  341/   72070 :                     	dc.b	vol
(2)  342/   72070 :                     	; Frequency envelope
(2)  343/   72070 :                     	if (SonicDriverVer>=3) && (SourceDriver<3)
(2)  344/   72070 :                     		; In SMPS 68k Type 1, this byte is skipped and can contain garbage.
(2)  345/   72070 :                     		; Sonic 2's Oil Ocean Zone and Ending themes set this byte to a non-zero value which
(2)  346/   72070 :                     		; other drivers may try to process as valid data, so manually force it to 0 here.
(2)  347/   72070 :                     		dc.b	0
(2)  348/   72070 :                     	else
(2)  349/   72070 :                     		if (MOMPASS==1) && (SonicDriverVer<3) && (SourceDriver>=3) && (mod<>0)
(2)  350/   72070 :                     			message "This track header specifies a frequency envelope, but this driver does not support them."			
(2)  351/   72070 :                     		endif
(2)  352/   72070 :                     		dc.b	mod
(2)  353/   72070 :                     	endif
(2)  354/   72070 :                     	; Volume envelope
(2)  355/   72070 :                     	dc.b	voice
(2)  356/   72070 :                     	endm
(2)  357/   72070 :                     
(2)  358/   72070 :                     ; Header macros for SFX (not for music)
(2)  359/   72070 :                     ; Header - Set up Tempo
(2)  360/   72070 :                     smpsHeaderTempoSFX macro div
(2)  361/   72070 :                     	dc.b	div
(2)  362/   72070 :                     	endm
(2)  363/   72070 :                     
(2)  364/   72070 :                     ; Header - Set up Channel Usage
(2)  365/   72070 :                     smpsHeaderChanSFX macro chan
(2)  366/   72070 :                     	dc.b	chan
(2)  367/   72070 :                     	endm
(2)  368/   72070 :                     
(2)  369/   72070 :                     ; Header - Set up FM Channel
(2)  370/   72070 :                     smpsHeaderSFXChannel macro chanid,loc,pitch,vol
(2)  371/   72070 :                     	if (SonicDriverVer>=3)&&(chanid==cNoise)
(2)  372/   72070 :                     		fatal "Using channel ID of cNoise ($E0) in Sonic 3 driver is dangerous. Fix the song so that it turns into a noise channel instead."
(2)  373/   72070 :                     	elseif (SonicDriverVer<3)&&(chanid==cFM6)
(2)  374/   72070 :                     		fatal "Using channel ID of FM6 ($06) in Sonic 1 or Sonic 2 drivers is unsupported. Change it to another channel."
(2)  375/   72070 :                     	endif
(2)  376/   72070 :                     	dc.b	$80,chanid
(2)  377/   72070 :                     	CheckedChannelPointer loc
(2)  378/   72070 :                     	if (chanid&$80)<>0
(2)  379/   72070 :                     		PSGPitchConvert pitch
(2)  380/   72070 :                     	else
(2)  381/   72070 :                     		dc.b	pitch
(2)  382/   72070 :                     	endif
(2)  383/   72070 :                     	dc.b	vol
(2)  384/   72070 :                     	endm
(2)  385/   72070 :                     ; ---------------------------------------------------------------------------
(2)  386/   72070 :                     ; Co-ord Flag Macros and Equates
(2)  387/   72070 :                     ; E0xx - Panning, AMS, FMS
(2)  388/   72070 :                     smpsPan macro direction,amsfms
(2)  389/   72070 :                     panNone set $00
(2)  390/   72070 :                     panRight set $40
(2)  391/   72070 :                     panLeft set $80
(2)  392/   72070 :                     panCentre set $C0
(2)  393/   72070 :                     panCenter set $C0 ; silly Americans :U
(2)  394/   72070 :                     	dc.b $E0,direction+amsfms
(2)  395/   72070 :                     	endm
(2)  396/   72070 :                     
(2)  397/   72070 :                     ; E1xx - Set channel detune to val
(2)  398/   72070 :                     smpsDetune macro val
(2)  399/   72070 :                     	dc.b	$E1,val
(2)  400/   72070 :                     	endm
(2)  401/   72070 :                     
(2)  402/   72070 :                     ; E2xx - Used for setting a variable which can be read by the game, for synchonisation. Ristar does this.
(2)  403/   72070 :                     smpsNop macro val
(2)  404/   72070 :                     	if (SonicDriverVer>=3) && ((val==$FF) || (val==$29))
(2)  405/   72070 :                     		warning "Values $FF and $29 are reserved in S3K's driver; use a different value or remove this command."
(2)  406/   72070 :                     	endif
(2)  407/   72070 :                     	dc.b	$E2,val
(2)  408/   72070 :                     	endm
(2)  409/   72070 :                     
(2)  410/   72070 :                     ; Return (used after smpsCall)
(2)  411/   72070 :                     smpsReturn macro val
(2)  412/   72070 :                     	if SonicDriverVer>=3
(2)  413/   72070 :                     		dc.b	$F9
(2)  414/   72070 :                     	else
(2)  415/   72070 :                     		dc.b	$E3
(2)  416/   72070 :                     	endif
(2)  417/   72070 :                     	endm
(2)  418/   72070 :                     
(2)  419/   72070 :                     ; Fade in previous song (ie. 1-Up)
(2)  420/   72070 :                     smpsFade macro val
(2)  421/   72070 :                     	if SonicDriverVer>=3
(2)  422/   72070 :                     		dc.b	$E2
(2)  423/   72070 :                     		if ("val"<>"")
(2)  424/   72070 :                     			dc.b	val
(2)  425/   72070 :                     		else
(2)  426/   72070 :                     			dc.b	$FF
(2)  427/   72070 :                     		endif
(2)  428/   72070 :                     		if SourceDriver<3
(2)  429/   72070 :                     			smpsStop
(2)  430/   72070 :                     		endif
(2)  431/   72070 :                     	elseif (SourceDriver>=3) && ("val"<>"") && ("val"<>"$FF")
(2)  432/   72070 :                     		; This is actually a communication byte, not a fade.
(2)  433/   72070 :                     		smpsNop	val
(2)  434/   72070 :                     	else
(2)  435/   72070 :                     		dc.b	$E4
(2)  436/   72070 :                     	endif
(2)  437/   72070 :                     	endm
(2)  438/   72070 :                     
(2)  439/   72070 :                     ; E5xx - Set channel tempo divider to xx
(2)  440/   72070 :                     smpsChanTempoDiv macro val
(2)  441/   72070 :                     	if SonicDriverVer>=5
(2)  442/   72070 :                     		; New flag unique to Flamewing's modified S&K driver
(2)  443/   72070 :                     		dc.b	$FF,$08,val
(2)  444/   72070 :                     	elseif SonicDriverVer==3
(2)  445/   72070 :                     		fatal "Coord. Flag to set tempo divider of a single channel does not exist in S3 driver. Use Flamewing's modified S&K sound driver instead."
(2)  446/   72070 :                     	else
(2)  447/   72070 :                     		dc.b	$E5,val
(2)  448/   72070 :                     	endif
(2)  449/   72070 :                     	endm
(2)  450/   72070 :                     
(2)  451/   72070 :                     ; E6xx - Alter Volume by xx
(2)  452/   72070 :                     smpsAlterVol macro val
(2)  453/   72070 :                     	dc.b	$E6,val
(2)  454/   72070 :                     	endm
(2)  455/   72070 :                     
(2)  456/   72070 :                     ; E7 - Prevent attack of next note
(2)  457/   72070 : =$E7                 smpsNoAttack	EQU $E7
(2)  458/   72070 :                     
(2)  459/   72070 :                     ; E8xx - Set note fill to xx
(2)  460/   72070 :                     smpsNoteFill macro val
(2)  461/   72070 :                     	if (SonicDriverVer>=5)&&(SourceDriver<3)
(2)  462/   72070 :                     		; Unique to Flamewing's modified driver
(2)  463/   72070 :                     		dc.b	$FF,$0A,val
(2)  464/   72070 :                     	else
(2)  465/   72070 :                     		if (SonicDriverVer>=3)&&(SourceDriver<3)
(2)  466/   72070 :                     			message "Note fill will not work as intended unless you divide the fill value by the tempo divider or complain to Flamewing to add an appropriate coordination flag for it."
(2)  467/   72070 :                     		elseif (SonicDriverVer<3)&&(SourceDriver>=3)
(2)  468/   72070 :                     			message "Note fill will not work as intended unless you multiply the fill value by the tempo divider or complain to Flamewing to add an appropriate coordination flag for it."
(2)  469/   72070 :                     		endif
(2)  470/   72070 :                     		dc.b	$E8,val
(2)  471/   72070 :                     	endif
(2)  472/   72070 :                     	endm
(2)  473/   72070 :                     
(2)  474/   72070 :                     ; Add xx to channel pitch
(2)  475/   72070 :                     smpsChangeTransposition macro val
(2)  476/   72070 :                     	if SonicDriverVer>=3
(2)  477/   72070 :                     		dc.b	$FB,val
(2)  478/   72070 :                     	else
(2)  479/   72070 :                     		dc.b	$E9,val
(2)  480/   72070 :                     	endif
(2)  481/   72070 :                     	endm
