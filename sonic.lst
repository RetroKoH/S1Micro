    4833/    6FE4 :                     
    4834/    6FE4 :                     ; Gets address of block at a certain coordinate
    4835/    6FE4 :                     ; Parameters:
    4836/    6FE4 :                     ; a4 = Pointer to level layout
    4837/    6FE4 :                     ; d4 = Relative Y coordinate
    4838/    6FE4 :                     ; d5 = Relative X coordinate
    4839/    6FE4 :                     ; Returns:
    4840/    6FE4 :                     ; a0 = Address of block metadata
    4841/    6FE4 :                     ; a1 = Address of block
    4842/    6FE4 :                     ; DrawBlocks:
    4843/    6FE4 :                     GetBlockData:
    4849/    6FE4 : DA53                			add.w	(a3),d5		; MJ: load X position to d5
    4850/    6FE6 :                     GetBlockData_2:
    4851/    6FE6 : D86B 0004           			add.w	4(a3),d4	; MJ: load Y position to d4
    4852/    6FEA : 43F8 B000           			lea	(v_16x16).w,a1	; MJ: load Block's location
    4854/    6FEE :                     		; Turn Y coordinate into index into level layout
    4855/    6FEE : 3604                		move.w	d4,d3		; MJ: copy Y position to d3
    4856/    6FF0 : 0243 0780           		andi.w	#$780,d3	; MJ: get within 780 (Not 380) (E00 pixels (not 700)) in multiples of 80
    4857/    6FF4 :                     		; Turn X coordinate into index into level layout
    4858/    6FF4 : E64D                		lsr.w	#3,d5		; MJ: divide X position by 8
    4859/    6FF6 : 3005                		move.w	d5,d0		; MJ: copy to d0
    4860/    6FF8 : E848                		lsr.w	#4,d0		; MJ: divide by 10 (Not 20)
    4861/    6FFA : 0240 007F           		andi.w	#$7F,d0		; MJ: get within 7F
    4862/    6FFE :                     		; Get chunk from level layout
    4863/    6FFE : E34B                		lsl.w	#1,d3		; MJ: multiply by 2 (So it skips the BG)
    4864/    7000 : D043                		add.w	d3,d0		; MJ: add calc'd Y pos
    4865/    7002 : 76FF                		moveq	#-1,d3		; MJ: prepare FFFF in d3
    4866/    7004 : 1634 0000           		move.b	(a4,d0.w),d3	; MJ: collect correct chunk ID from layout
    4867/    7008 :                     		; Turn chunk ID into index into chunk table
    4868/    7008 : 0243 00FF           		andi.w	#$FF,d3		; MJ: keep within FF
    4869/    700C : EF4B                		lsl.w	#7,d3		; MJ: multiply by 80
    4870/    700E :                     		; Turn Y coordinate into index into chunk
    4871/    700E : 0244 0070           		andi.w	#$70,d4		; MJ: keep Y pos within 80 pixels
    4872/    7012 :                     		; Turn X coordinate into index into chunk
    4873/    7012 : 0245 000E           		andi.w	#$E,d5		; MJ: keep X pos within 10
    4874/    7016 :                     		; Get block metadata from chunk
    4875/    7016 : D644                		add.w	d4,d3		; MJ: add calc'd Y pos to ror'd d3
    4876/    7018 : D645                		add.w	d5,d3		; MJ: add calc'd X pos to ror'd d3
    4877/    701A : 2043                		movea.l	d3,a0		; MJ: set address (Chunk to read)
    4878/    701C : 3610                		move.w	(a0),d3
    4879/    701E :                     		; Turn block ID into address
    4880/    701E : 0243 03FF           		andi.w	#$3FF,d3
    4881/    7022 : E74B                		lsl.w	#3,d3
    4882/    7024 : D2C3                		adda.w	d3,a1
