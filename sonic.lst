    6811/   14D44 :                     
    6812/   14D44 :                     ; ---------------------------------------------------------------------------
    6813/   14D44 :                     ; This subroutine takes 'raw' bitmap-like collision block data as input and
    6814/   14D44 :                     ; converts it into the proper collision arrays (ColArray and ColArray2).
    6815/   14D44 :                     ; Pointers to said raw data are dummied out.
    6816/   14D44 :                     ; Curiously, an example of the original 'raw' data that this was intended
    6817/   14D44 :                     ; to process can be found in the J2ME version, in a file called 'blkcol.bct'.
    6818/   14D44 :                     ; ---------------------------------------------------------------------------
    6819/   14D44 :                     
    6820/   14D44 : =$5FACA              RawColBlocks		equ CollArray1
    6821/   14D44 : =$5FACA              ConvRowColBlocks	equ CollArray1
    6822/   14D44 :                     
    6823/   14D44 :                     ; ||||||||||||||| S U B R O U T I N E |||||||||||||||||||||||||||||||||||||||
    6824/   14D44 :                     
    6825/   14D44 :                     
    6826/   14D44 :                     ConvertCollisionArray:
    6827/   14D44 : 4E75                		rts	
    6828/   14D46 :                     ; ---------------------------------------------------------------------------
    6829/   14D46 :                     		; The raw format stores the collision data column by column for the normal collision array.
    6830/   14D46 :                     		; This makes a copy of the data, but stored row by row, for the rotated collision array.
    6831/   14D46 : 43F9 0005 FACA      		lea	(RawColBlocks).l,a1	; Source location of raw collision block data
    6832/   14D4C : 45F9 0005 FACA      		lea	(ConvRowColBlocks).l,a2	; Destinatation location for row-converted collision block data
    6833/   14D52 :                     
    6834/   14D52 : 363C 00FF           		move.w	#$100-1,d3		; Number of blocks in collision data
    6835/   14D56 :                     
    6836/   14D56 :                     .blockLoop:
    6837/   14D56 : 7A10                		moveq	#16,d5			; Start on the 16th bit (the leftmost pixel)
    6838/   14D58 :                     
    6839/   14D58 : 343C 000F           		move.w	#16-1,d2		; Width of a block in pixels
    6840/   14D5C :                     
    6841/   14D5C :                     .columnLoop:
    6842/   14D5C : 7800                		moveq	#0,d4
    6843/   14D5E :                     
    6844/   14D5E : 323C 000F           		move.w	#16-1,d1		; Height of a block in pixels
    6845/   14D62 :                     
    6846/   14D62 :                     .rowLoop:
    6847/   14D62 : 3019                		move.w	(a1)+,d0		; Get row of collision bits
    6848/   14D64 : EAA8                		lsr.l	d5,d0			; Push the selected bit of this row into the 'eXtend' flag
    6849/   14D66 : D944                		addx.w	d4,d4			; Shift d4 to the left, and insert the selected bit into bit 0
    6850/   14D68 : 51C9 FFF8           		dbf	d1,.rowLoop		; Loop for each row of pixels in a block
    6851/   14D6C :                     
    6852/   14D6C : 34C4                		move.w	d4,(a2)+		; Store column of collision bits
    6853/   14D6E : 92FC 0020           		suba.w	#2*16,a1		; Back to the start of the block
    6854/   14D72 : 5345                		subq.w	#1,d5			; Get next bit in the row
    6855/   14D74 : 51CA FFE6           		dbf	d2,.columnLoop		; Loop for each column of pixels in a block
    6856/   14D78 :                     
    6857/   14D78 : D2FC 0020           		adda.w	#2*16,a1		; Next block
    6858/   14D7C : 51CB FFD8           		dbf	d3,.blockLoop		; Loop for each block in the raw collision block data
    6859/   14D80 :                     
    6860/   14D80 :                     		; This then converts the collision data into the final collision arrays
    6861/   14D80 : 43F9 0005 FACA      		lea	(ConvRowColBlocks).l,a1
    6862/   14D86 : 45F9 0006 0ACA      		lea	(CollArray2).l,a2	; Convert the row-converted collision block data into final rotated collision array
    6863/   14D8C : 610C                		bsr.s	.convertArray
    6864/   14D8E : 43F9 0005 FACA      		lea	(RawColBlocks).l,a1
    6865/   14D94 : 45F9 0005 FACA      		lea	(CollArray1).l,a2	; Convert the raw collision block data into final normal collision array
    6866/   14D9A :                     
    6867/   14D9A :                     
    6868/   14D9A :                     .convertArray:
    6869/   14D9A : 363C 0FFF           		move.w	#$1000-1,d3		; Size of the collision array
    6870/   14D9E :                     
    6871/   14D9E :                     .processLoop:
    6872/   14D9E : 7400                		moveq	#0,d2
    6873/   14DA0 : 323C 000F           		move.w	#$F,d1
    6874/   14DA4 : 3019                		move.w	(a1)+,d0		; Get current column of collision pixels
    6875/   14DA6 : 6724                		beq.s	.noCollision		; Branch if there's no collision in this column
    6876/   14DA8 : 6B0C                		bmi.s	.topPixelSolid		; Branch if top pixel of collision is solid
    6877/   14DAA :                     
    6878/   14DAA :                     	; Here we count, starting from the bottom, how many pixels tall
    6879/   14DAA :                     	; the collision in this column is.
    6880/   14DAA :                     .processColumnLoop1:
    6881/   14DAA : E248                		lsr.w	#1,d0
    6882/   14DAC : 6402                		bhs.s	.pixelNotSolid1
    6883/   14DAE : 5202                		addq.b	#1,d2
    6884/   14DB0 :                     
    6885/   14DB0 :                     .pixelNotSolid1:
    6886/   14DB0 : 51C9 FFF8           		dbf	d1,.processColumnLoop1
    6887/   14DB4 :                     
    6888/   14DB4 : 6018                		bra.s	.columnProcessed
    6889/   14DB6 :                     ; ===========================================================================
    6890/   14DB6 :                     
    6891/   14DB6 :                     .topPixelSolid:
    6892/   14DB6 : 0C40 FFFF           		cmpi.w	#$FFFF,d0		; Is entire column solid?
    6893/   14DBA : 670C                		beq.s	.entireColumnSolid	; Branch if so
    6894/   14DBC :                     
    6895/   14DBC :                     	; Here we count, starting from the top, how many pixels tall
    6896/   14DBC :                     	; the collision in this column is (the resulting number is negative).
    6897/   14DBC :                     .processColumnLoop2:
    6898/   14DBC : E348                		lsl.w	#1,d0
    6899/   14DBE : 6402                		bhs.s	.pixelNotSolid2
    6900/   14DC0 : 5302                		subq.b	#1,d2
    6901/   14DC2 :                     
    6902/   14DC2 :                     .pixelNotSolid2:
    6903/   14DC2 : 51C9 FFF8           		dbf	d1,.processColumnLoop2
    6904/   14DC6 :                     
    6905/   14DC6 : 6006                		bra.s	.columnProcessed
    6906/   14DC8 :                     ; ===========================================================================
    6907/   14DC8 :                     
    6908/   14DC8 :                     .entireColumnSolid:
    6909/   14DC8 : 303C 0010           		move.w	#$10,d0
    6910/   14DCC :                     
    6911/   14DCC :                     .noCollision:
    6912/   14DCC : 3400                		move.w	d0,d2
    6913/   14DCE :                     
    6914/   14DCE :                     .columnProcessed:
    6915/   14DCE : 14C2                		move.b	d2,(a2)+		; Store column collision height
    6916/   14DD0 : 51CB FFCC           		dbf	d3,.processLoop
    6917/   14DD4 :                     
    6918/   14DD4 : 4E75                		rts	
    6919/   14DD6 :                     
    6920/   14DD6 :                     ; End of function ConvertCollisionArray
    6921/   14DD6 :                     
    6922/   14DD6 :                     
    6923/   14DD6 :                     ; ||||||||||||||| S U B R O U T I N E |||||||||||||||||||||||||||||||||||||||
    6924/   14DD6 :                     
    6925/   14DD6 :                     
    6926/   14DD6 :                     Sonic_WalkSpeed:
    6927/   14DD6 : 31FC 9000 F796      		move.w	#v_collision1,(v_collindex).w	; MJ: load first collision data location
    6928/   14DDC : 0C38 000C FFC4      		cmpi.b	#$C,(v_top_solid_bit).w		; MJ: is second collision set to be used?
    6929/   14DE2 : 6706                		beq.s	.first				; MJ: if not, branch
    6930/   14DE4 : 31FC 9300 F796      		move.w	#v_collision2,(v_collindex).w	; MJ: load second collision data location
    6931/   14DEA :                     .first:
    6932/   14DEA : 1A38 FFC5           		move.b	(v_lrb_solid_bit).w,d5		; MJ: load L/R/B soldity bit
    6933/   14DEE : 2628 0008           		move.l	obX(a0),d3
    6934/   14DF2 : 2428 000C           		move.l	obY(a0),d2
    6935/   14DF6 : 3228 0010           		move.w	obVelX(a0),d1
    6936/   14DFA : 48C1                		ext.l	d1
    6937/   14DFC : E181                		asl.l	#8,d1
    6938/   14DFE : D681                		add.l	d1,d3
    6939/   14E00 : 3228 0012           		move.w	obVelY(a0),d1
    6940/   14E04 : 48C1                		ext.l	d1
    6941/   14E06 : E181                		asl.l	#8,d1
    6942/   14E08 : D481                		add.l	d1,d2
    6943/   14E0A : 4842                		swap	d2
    6944/   14E0C : 4843                		swap	d3
    6945/   14E0E : 11C0 F768           		move.b	d0,(v_anglebuffer).w
    6946/   14E12 : 11C0 F76A           		move.b	d0,(v_anglebuffer2).w
    6947/   14E16 : 1200                		move.b	d0,d1
    6948/   14E18 : 0600 0020           		addi.b	#$20,d0
    6949/   14E1C : 6A0C                		bpl.s	loc_14D1A
    6950/   14E1E : 1001                		move.b	d1,d0
    6951/   14E20 : 6A02                		bpl.s	loc_14D14
    6952/   14E22 : 5300                		subq.b	#1,d0
    6953/   14E24 :                     
    6954/   14E24 :                     loc_14D14:
    6955/   14E24 : 0600 0020           		addi.b	#$20,d0
    6956/   14E28 : 600A                		bra.s	loc_14D24
    6957/   14E2A :                     ; ===========================================================================
