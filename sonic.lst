    4777/    6F78 : 2C99                		move.l	(a1)+,(a6)	; Write top two tiles
    4778/    6F7A : D087                		add.l	d7,d0		; Next row
    4779/    6F7C : 2A80                		move.l	d0,(a5)
    4780/    6F7E : 2C99                		move.l	(a1)+,(a6)	; Write bottom two tiles
    4781/    6F80 : 4E75                		rts	
