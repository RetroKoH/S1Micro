    7081/   14DE2 :                     
    7082/   14DE2 :                     ; ---------------------------------------------------------------------------
    7083/   14DE2 :                     ; This subroutine takes 'raw' bitmap-like collision block data as input and
    7084/   14DE2 :                     ; converts it into the proper collision arrays (ColArray and ColArray2).
    7085/   14DE2 :                     ; Pointers to said raw data are dummied out.
    7086/   14DE2 :                     ; Curiously, an example of the original 'raw' data that this was intended
    7087/   14DE2 :                     ; to process can be found in the J2ME version, in a file called 'blkcol.bct'.
    7088/   14DE2 :                     ; ---------------------------------------------------------------------------
    7089/   14DE2 :                     
    7090/   14DE2 : =$5F98A              RawColBlocks		equ CollArray1
    7091/   14DE2 : =$5F98A              ConvRowColBlocks	equ CollArray1
    7092/   14DE2 :                     
    7093/   14DE2 :                     ; ||||||||||||||| S U B R O U T I N E |||||||||||||||||||||||||||||||||||||||
    7094/   14DE2 :                     
    7095/   14DE2 :                     
    7096/   14DE2 :                     ConvertCollisionArray:
    7097/   14DE2 : 4E75                		rts	
    7098/   14DE4 :                     ; ---------------------------------------------------------------------------
    7099/   14DE4 :                     		; The raw format stores the collision data column by column for the normal collision array.
    7100/   14DE4 :                     		; This makes a copy of the data, but stored row by row, for the rotated collision array.
    7101/   14DE4 : 43F9 0005 F98A      		lea	(RawColBlocks).l,a1	; Source location of raw collision block data
    7102/   14DEA : 45F9 0005 F98A      		lea	(ConvRowColBlocks).l,a2	; Destinatation location for row-converted collision block data
    7103/   14DF0 :                     
    7104/   14DF0 : 363C 00FF           		move.w	#$100-1,d3		; Number of blocks in collision data
    7105/   14DF4 :                     
    7106/   14DF4 :                     .blockLoop:
    7107/   14DF4 : 7A10                		moveq	#16,d5			; Start on the 16th bit (the leftmost pixel)
    7108/   14DF6 :                     
    7109/   14DF6 : 343C 000F           		move.w	#16-1,d2		; Width of a block in pixels
    7110/   14DFA :                     
    7111/   14DFA :                     .columnLoop:
    7112/   14DFA : 7800                		moveq	#0,d4
    7113/   14DFC :                     
    7114/   14DFC : 323C 000F           		move.w	#16-1,d1		; Height of a block in pixels
    7115/   14E00 :                     
    7116/   14E00 :                     .rowLoop:
    7117/   14E00 : 3019                		move.w	(a1)+,d0		; Get row of collision bits
    7118/   14E02 : EAA8                		lsr.l	d5,d0			; Push the selected bit of this row into the 'eXtend' flag
    7119/   14E04 : D944                		addx.w	d4,d4			; Shift d4 to the left, and insert the selected bit into bit 0
    7120/   14E06 : 51C9 FFF8           		dbf	d1,.rowLoop		; Loop for each row of pixels in a block
    7121/   14E0A :                     
    7122/   14E0A : 34C4                		move.w	d4,(a2)+		; Store column of collision bits
    7123/   14E0C : 92FC 0020           		suba.w	#2*16,a1		; Back to the start of the block
    7124/   14E10 : 5345                		subq.w	#1,d5			; Get next bit in the row
    7125/   14E12 : 51CA FFE6           		dbf	d2,.columnLoop		; Loop for each column of pixels in a block
    7126/   14E16 :                     
    7127/   14E16 : D2FC 0020           		adda.w	#2*16,a1		; Next block
    7128/   14E1A : 51CB FFD8           		dbf	d3,.blockLoop		; Loop for each block in the raw collision block data
    7129/   14E1E :                     
    7130/   14E1E :                     		; This then converts the collision data into the final collision arrays
    7131/   14E1E : 43F9 0005 F98A      		lea	(ConvRowColBlocks).l,a1
    7132/   14E24 : 45F9 0006 098A      		lea	(CollArray2).l,a2	; Convert the row-converted collision block data into final rotated collision array
    7133/   14E2A : 610C                		bsr.s	.convertArray
    7134/   14E2C : 43F9 0005 F98A      		lea	(RawColBlocks).l,a1
    7135/   14E32 : 45F9 0005 F98A      		lea	(CollArray1).l,a2	; Convert the raw collision block data into final normal collision array
    7136/   14E38 :                     
    7137/   14E38 :                     
    7138/   14E38 :                     .convertArray:
    7139/   14E38 : 363C 0FFF           		move.w	#$1000-1,d3		; Size of the collision array
    7140/   14E3C :                     
    7141/   14E3C :                     .processLoop:
    7142/   14E3C : 7400                		moveq	#0,d2
    7143/   14E3E : 323C 000F           		move.w	#$F,d1
    7144/   14E42 : 3019                		move.w	(a1)+,d0		; Get current column of collision pixels
    7145/   14E44 : 6724                		beq.s	.noCollision		; Branch if there's no collision in this column
    7146/   14E46 : 6B0C                		bmi.s	.topPixelSolid		; Branch if top pixel of collision is solid
    7147/   14E48 :                     
    7148/   14E48 :                     	; Here we count, starting from the bottom, how many pixels tall
    7149/   14E48 :                     	; the collision in this column is.
    7150/   14E48 :                     .processColumnLoop1:
    7151/   14E48 : E248                		lsr.w	#1,d0
    7152/   14E4A : 6402                		bhs.s	.pixelNotSolid1
    7153/   14E4C : 5202                		addq.b	#1,d2
    7154/   14E4E :                     
    7155/   14E4E :                     .pixelNotSolid1:
    7156/   14E4E : 51C9 FFF8           		dbf	d1,.processColumnLoop1
    7157/   14E52 :                     
    7158/   14E52 : 6018                		bra.s	.columnProcessed
    7159/   14E54 :                     ; ===========================================================================
    7160/   14E54 :                     
    7161/   14E54 :                     .topPixelSolid:
    7162/   14E54 : 0C40 FFFF           		cmpi.w	#$FFFF,d0		; Is entire column solid?
    7163/   14E58 : 670C                		beq.s	.entireColumnSolid	; Branch if so
    7164/   14E5A :                     
    7165/   14E5A :                     	; Here we count, starting from the top, how many pixels tall
    7166/   14E5A :                     	; the collision in this column is (the resulting number is negative).
    7167/   14E5A :                     .processColumnLoop2:
    7168/   14E5A : E348                		lsl.w	#1,d0
    7169/   14E5C : 6402                		bhs.s	.pixelNotSolid2
    7170/   14E5E : 5302                		subq.b	#1,d2
    7171/   14E60 :                     
    7172/   14E60 :                     .pixelNotSolid2:
    7173/   14E60 : 51C9 FFF8           		dbf	d1,.processColumnLoop2
    7174/   14E64 :                     
    7175/   14E64 : 6006                		bra.s	.columnProcessed
    7176/   14E66 :                     ; ===========================================================================
    7177/   14E66 :                     
    7178/   14E66 :                     .entireColumnSolid:
    7179/   14E66 : 303C 0010           		move.w	#$10,d0
    7180/   14E6A :                     
    7181/   14E6A :                     .noCollision:
    7182/   14E6A : 3400                		move.w	d0,d2
    7183/   14E6C :                     
    7184/   14E6C :                     .columnProcessed:
    7185/   14E6C : 14C2                		move.b	d2,(a2)+		; Store column collision height
    7186/   14E6E : 51CB FFCC           		dbf	d3,.processLoop
    7187/   14E72 :                     
    7188/   14E72 : 4E75                		rts	
    7189/   14E74 :                     
    7190/   14E74 :                     ; End of function ConvertCollisionArray
    7191/   14E74 :                     
    7192/   14E74 :                     
    7193/   14E74 :                     ; ||||||||||||||| S U B R O U T I N E |||||||||||||||||||||||||||||||||||||||
    7194/   14E74 :                     
    7195/   14E74 :                     
    7196/   14E74 :                     Sonic_WalkSpeed:
    7197/   14E74 : 31FC 9000 F796      		move.w	#v_collision1,(v_collindex).w	; MJ: load first collision data location
