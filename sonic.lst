(1) 1763/   70224 :                     ; ===========================================================================
(1) 1764/   70224 :                     ; ---------------------------------------------------------------------------
(1) 1765/   70224 :                     ; FM Note Values: b-0 to a#8
(1) 1766/   70224 :                     ;
(1) 1767/   70224 :                     ; Each row is an octave, starting with B and ending with A-sharp/B-flat.
(1) 1768/   70224 :                     ; Notably, this differs from the PSG frequency table, which starts with C and
(1) 1769/   70224 :                     ; ends with B. This is caused by 'FMSetFreq' subtracting $80 from the note
(1) 1770/   70224 :                     ; instead of $81, meaning that the first frequency in the table ironically
(1) 1771/   70224 :                     ; corresponds to the 'rest' note. The only way to use this frequency in a
(1) 1772/   70224 :                     ; real note is to transpose the channel to a lower semitone.
(1) 1773/   70224 :                     ;
(1) 1774/   70224 :                     ; Rather than use a complete lookup table, other SMPS drivers such as
(1) 1775/   70224 :                     ; Sonic 3's compute the octave, and only store a single octave's worth of
(1) 1776/   70224 :                     ; notes in the table.
(1) 1777/   70224 :                     ;
(1) 1778/   70224 :                     ; Invalid transposition values will cause this table to be overflowed,
(1) 1779/   70224 :                     ; resulting in garbage data being used as frequency values. In drivers that
(1) 1780/   70224 :                     ; compute the octave instead, invalid transposition values merely cause the
(1) 1781/   70224 :                     ; notes to wrap-around (the note below the lowest note will be the highest
(1) 1782/   70224 :                     ; note). It's important to keep this in mind when porting buggy songs.
(1) 1783/   70224 :                     ; ---------------------------------------------------------------------------
(1) 1784/   70224 :                     MakeFMFrequency function frequency,roundFloatToInteger(frequency*1024*1024*2/FM_Sample_Rate)
(1) 1785/   70224 :                     MakeFMFrequenciesOctave macro octave
(1) 1786/   70224 :                     		; Frequencies for the base octave. The first frequency is B, the last frequency is B-flat.
(1) 1787/   70224 :                     		irp op, 15.39, 16.35, 17.34, 18.36, 19.45, 20.64, 21.84, 23.13, 24.51, 25.98, 27.53, 29.15
(1) 1788/   70224 :                     			dc.w MakeFMFrequency(op)+octave*$800
(1) 1789/   70224 :                     		endm
(1) 1790/   70224 :                     	endm
(1) 1791/   70224 :                     
(1) 1792/   70224 :                     ; word_72790: FM_Notes:
(1) 1793/   70224 :                     FMFrequencies:
(1) 1794/   70224 : (MACRO)              		MakeFMFrequenciesOctave 0
(1) 1794/   70224 :                                     ; Frequencies for the base 0. The first frequency is B, the last frequency is B-flat.
(1) 1794/   70224 :                                     irp op, 15.39, 16.35, 17.34, 18.36, 19.45, 20.64, 21.84, 23.13, 24.51, 25.98, 27.53, 29.15
(1) 1794/   70224 :                                             dc.w MakeFMFrequency(op)+0*$800
(1) 1794/   70224 :                                     endm
(1) 1794/   70224 : 025E                                        dc.w MakeFMFrequency(15.39)+0*$800
(1) 1794/   70226 : 0284                                        dc.w MakeFMFrequency(16.35)+0*$800
(1) 1794/   70228 : 02AB                                        dc.w MakeFMFrequency(17.34)+0*$800
(1) 1794/   7022A : 02D3                                        dc.w MakeFMFrequency(18.36)+0*$800
