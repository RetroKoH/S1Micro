(2)   15/   71F7C :                     
(2)   16/   71F7C : =$1                  SMPS2ASMVer	= 1
(2)   17/   71F7C :                     
(2)   18/   71F7C :                     ; PSG conversion to S3/S&K/S3D drivers require a tone shift of 12 semi-tones.
(2)   19/   71F7C : =$C                  psgdelta	EQU 12
(2)   20/   71F7C :                     ; ---------------------------------------------------------------------------
(2)   21/   71F7C :                     ; Standard Octave Pitch Equates
(2)   22/   71F7C :                     	enumconf	$C
(2)   23/   71F7C : =$88..$B8            	enum		smpsPitch10lo=$88,smpsPitch09lo,smpsPitch08lo,smpsPitch07lo,smpsPitch06lo
(2)   24/   71F7C : =$C4..$F4            	nextenum	smpsPitch05lo,smpsPitch04lo,smpsPitch03lo,smpsPitch02lo,smpsPitch01lo
(2)   25/   71F7C : =$0..$30             	enum		smpsPitch00=$00,smpsPitch01hi,smpsPitch02hi,smpsPitch03hi,smpsPitch04hi
(2)   26/   71F7C : =$3C..$6C            	nextenum	smpsPitch05hi,smpsPitch06hi,smpsPitch07hi,smpsPitch08hi,smpsPitch09hi
(2)   27/   71F7C : =$78                 	nextenum	smpsPitch10hi
(2)   28/   71F7C :                     	enumconf	1
(2)   29/   71F7C :                     ; ---------------------------------------------------------------------------
(2)   30/   71F7C :                     ; Note Equates
(2)   31/   71F7C : =$80                 	enum		nRst=$80
(2)   32/   71F7C : =$81..$86            	nextenum	nC0,nCs0,nDb0=nCs0,nD0,nDs0,nEb0=nDs0,nE0,nFb0=nE0,nEs0,nF0=nEs0
(2)   33/   71F7C : =$87..$8D            	nextenum	nFs0,nGb0=nFs0,nG0,nGs0,nAb0=nGs0,nA0,nAs0,nBb0=nAs0,nB0,nCb1=nB0,nBs0
(2)   34/   71F7C : =$8D..$92            	nextenum	nC1=nBs0,nCs1,nDb1=nCs1,nD1,nDs1,nEb1=nDs1,nE1,nFb1=nE1,nEs1,nF1=nEs1
(2)   35/   71F7C : =$93..$99            	nextenum	nFs1,nGb1=nFs1,nG1,nGs1,nAb1=nGs1,nA1,nAs1,nBb1=nAs1,nB1,nCb2=nB1,nBs1
(2)   36/   71F7C : =$99..$9E            	nextenum	nC2=nBs1,nCs2,nDb2=nCs2,nD2,nDs2,nEb2=nDs2,nE2,nFb2=nE2,nEs2,nF2=nEs2
(2)   37/   71F7C : =$9F..$A5            	nextenum	nFs2,nGb2=nFs2,nG2,nGs2,nAb2=nGs2,nA2,nAs2,nBb2=nAs2,nB2,nCb3=nB2,nBs2
(2)   38/   71F7C : =$A5..$AA            	nextenum	nC3=nBs2,nCs3,nDb3=nCs3,nD3,nDs3,nEb3=nDs3,nE3,nFb3=nE3,nEs3,nF3=nEs3
(2)   39/   71F7C : =$AB..$B1            	nextenum	nFs3,nGb3=nFs3,nG3,nGs3,nAb3=nGs3,nA3,nAs3,nBb3=nAs3,nB3,nCb4=nB3,nBs3
(2)   40/   71F7C : =$B1..$B6            	nextenum	nC4=nBs3,nCs4,nDb4=nCs4,nD4,nDs4,nEb4=nDs4,nE4,nFb4=nE4,nEs4,nF4=nEs4
(2)   41/   71F7C : =$B7..$BD            	nextenum	nFs4,nGb4=nFs4,nG4,nGs4,nAb4=nGs4,nA4,nAs4,nBb4=nAs4,nB4,nCb5=nB4,nBs4
(2)   42/   71F7C : =$BD..$C2            	nextenum	nC5=nBs4,nCs5,nDb5=nCs5,nD5,nDs5,nEb5=nDs5,nE5,nFb5=nE5,nEs5,nF5=nEs5
(2)   43/   71F7C : =$C3..$C9            	nextenum	nFs5,nGb5=nFs5,nG5,nGs5,nAb5=nGs5,nA5,nAs5,nBb5=nAs5,nB5,nCb6=nB5,nBs5
(2)   44/   71F7C : =$C9..$CE            	nextenum	nC6=nBs5,nCs6,nDb6=nCs6,nD6,nDs6,nEb6=nDs6,nE6,nFb6=nE6,nEs6,nF6=nEs6
(2)   45/   71F7C : =$CF..$D5            	nextenum	nFs6,nGb6=nFs6,nG6,nGs6,nAb6=nGs6,nA6,nAs6,nBb6=nAs6,nB6,nCb7=nB6,nBs6
(2)   46/   71F7C : =$D5..$DA            	nextenum	nC7=nBs6,nCs7,nDb7=nCs7,nD7,nDs7,nEb7=nDs7,nE7,nFb7=nE7,nEs7,nF7=nEs7
(2)   47/   71F7C : =$DB..$DF            	nextenum	nFs7,nGb7=nFs7,nG7,nGs7,nAb7=nGs7,nA7,nAs7,nBb7=nAs7
(2)   48/   71F7C :                     ; SMPS2ASM uses nMaxPSG for songs from S1/S2 drivers.
(2)   49/   71F7C :                     ; nMaxPSG1 and nMaxPSG2 are used only for songs from S3/S&K/S3D drivers.
(2)   50/   71F7C :                     ; The use of psgdelta is intended to undo the effects of PSGPitchConvert
(2)   51/   71F7C :                     ; and ensure that the ending note is indeed the maximum PSG frequency.
(2)   53/   71F7C : =$C6                 nMaxPSG				EQU nA5
(2)   54/   71F7C : =$D2                 nMaxPSG1			EQU nA5+psgdelta
(2)   55/   71F7C : =$D2                 nMaxPSG2			EQU nA5+psgdelta
(2)   61/   71F7C :                     ; ---------------------------------------------------------------------------
(2)   62/   71F7C :                     ; PSG volume envelope equates
(2)   65/   71F7C : =$1..$6              			enum		fTone_01=$01,fTone_02,fTone_03,fTone_04,fTone_05,fTone_06
(2)   66/   71F7C : =$7..$9              			nextenum	fTone_07,fTone_08,fTone_09
(2)   86/   71F7C :                     ; ---------------------------------------------------------------------------
(2)   87/   71F7C :                     ; DAC Equates
(2)   90/   71F7C : =$81..$83            			enum		dKick=$81,dSnare,dTimpani
(2)   91/   71F7C : =$88..$8B            			enum		dHiTimpani=$88,dMidTimpani,dLowTimpani,dVLowTimpani
(2)  169/   71F7C :                     ; ---------------------------------------------------------------------------
(2)  170/   71F7C :                     ; Channel IDs for SFX
(2)  171/   71F7C : =$80                 cPSG1				EQU $80
(2)  172/   71F7C : =$A0                 cPSG2				EQU $A0
(2)  173/   71F7C : =$C0                 cPSG3				EQU $C0
(2)  174/   71F7C : =$E0                 cNoise				EQU $E0	; Not for use in S3/S&K/S3D
(2)  175/   71F7C : =$2                  cFM3				EQU $02
(2)  176/   71F7C : =$4                  cFM4				EQU $04
(2)  177/   71F7C : =$5                  cFM5				EQU $05
(2)  178/   71F7C : =$6                  cFM6				EQU $06	; Only in S3/S&K/S3D, overrides DAC
(2)  179/   71F7C :                     ; ---------------------------------------------------------------------------
(2)  180/   71F7C :                     ; Conversion macros and functions
(2)  181/   71F7C :                     
(2)  182/   71F7C :                     conv0To256  function n,((n==0)<<8)|n
(2)  183/   71F7C :                     s2TempotoS1 function n,(((768-n)>>1)/(256-n))&$FF
(2)  184/   71F7C :                     s2TempotoS3 function n,($100-((n==0)|n))&$FF
(2)  185/   71F7C :                     s1TempotoS2 function n,((((conv0To256(n)-1)<<8)+(conv0To256(n)>>1))/conv0To256(n))&$FF
(2)  186/   71F7C :                     s1TempotoS3 function n,s2TempotoS3(s1TempotoS2(n))
(2)  187/   71F7C :                     s3TempotoS1 function n,s2TempotoS1(s2TempotoS3(n))
(2)  188/   71F7C :                     s3TempotoS2 function n,s2TempotoS3(n)
(2)  189/   71F7C :                     
(2)  190/   71F7C :                     convertMainTempoMod macro mod
(2)  191/   71F7C :                     	if ((SourceDriver>=3)&&(SonicDriverVer>=3))||(SonicDriverVer==SourceDriver)
(2)  192/   71F7C :                     		dc.b	mod
(2)  193/   71F7C :                     	elseif SourceDriver==1
(2)  194/   71F7C :                     		if mod==1
(2)  195/   71F7C :                     			fatal "Invalid main tempo of 1 in song from Sonic 1"
(2)  196/   71F7C :                     		endif
(2)  197/   71F7C :                     		if SonicDriverVer==2
(2)  198/   71F7C :                     			dc.b	s1TempotoS2(mod)
(2)  199/   71F7C :                     		else;if SonicDriverVer>=3
(2)  200/   71F7C :                     			dc.b	s1TempotoS3(mod)
(2)  201/   71F7C :                     		endif
(2)  202/   71F7C :                     	elseif SourceDriver==2
(2)  203/   71F7C :                     		if mod==0
(2)  204/   71F7C :                     			fatal "Invalid main tempo of 0 in song from Sonic 2"
(2)  205/   71F7C :                     		endif
(2)  206/   71F7C :                     		if SonicDriverVer==1
(2)  207/   71F7C :                     			dc.b	s2TempotoS1(mod)
(2)  208/   71F7C :                     		else;if SonicDriverVer>=3
(2)  209/   71F7C :                     			dc.b	s2TempotoS3(mod)
(2)  210/   71F7C :                     		endif
(2)  211/   71F7C :                     	else;if SourceDriver>=3
(2)  212/   71F7C :                     		if mod==0
(2)  213/   71F7C :                     			message "Performing approximate conversion of Sonic 3 main tempo modifier of 0"
(2)  214/   71F7C :                     		endif
(2)  215/   71F7C :                     		if SonicDriverVer==1
(2)  216/   71F7C :                     			dc.b	s3TempotoS1(mod)
(2)  217/   71F7C :                     		else;if SonicDriverVer==2
(2)  218/   71F7C :                     			dc.b	s3TempotoS2(mod)
(2)  219/   71F7C :                     		endif
(2)  220/   71F7C :                     	endif
(2)  221/   71F7C :                     	endm
(2)  222/   71F7C :                     
(2)  223/   71F7C :                     ; PSG conversion to S3/S&K/S3D drivers require a tone shift of 12 semi-tones.
(2)  224/   71F7C :                     PSGPitchConvert macro pitch
(2)  225/   71F7C :                     	if (SonicDriverVer>=3)&&(SourceDriver<3)
(2)  226/   71F7C :                     		dc.b	(pitch+psgdelta)&$FF
(2)  227/   71F7C :                     	elseif (SonicDriverVer<3)&&(SourceDriver>=3)
(2)  228/   71F7C :                     		dc.b	(pitch-psgdelta)&$FF
(2)  229/   71F7C :                     	else
(2)  230/   71F7C :                     		dc.b	pitch
(2)  231/   71F7C :                     	endif
(2)  232/   71F7C :                     	endm
(2)  233/   71F7C :                     
(2)  234/   71F7C :                     CheckedChannelPointer macro loc
(2)  235/   71F7C :                     	if SonicDriverVer<>1
(2)  236/   71F7C :                     		dc.w	z80_ptr(loc)
(2)  237/   71F7C :                     	else
(2)  238/   71F7C :                     		if (MOMPASS=1)&&(DEFINED(loc))
(2)  239/   71F7C :                     			fatal "Tracks for Sonic 1 songs must come after the start of the song"
(2)  240/   71F7C :                     		endif
(2)  241/   71F7C :                     		dc.w	loc-songStart
(2)  242/   71F7C :                     	endif
(2)  243/   71F7C :                     	endm
(2)  244/   71F7C :                     ; ---------------------------------------------------------------------------
(2)  245/   71F7C :                     ; Header Macros
(2)  246/   71F7C :                     smpsHeaderStartSong macro ver, sourcesmps2asmver
(2)  247/   71F7C :                     
(2)  248/   71F7C :                     SourceDriver set ver
(2)  249/   71F7C :                     
(2)  250/   71F7C :                     	if ("sourcesmps2asmver"<>"")
(2)  251/   71F7C :                     		set SourceSMPS2ASM,sourcesmps2asmver
(2)  252/   71F7C :                     	else
(2)  253/   71F7C :                     		set SourceSMPS2ASM,0
(2)  254/   71F7C :                     	endif
(2)  255/   71F7C :                     
(2)  256/   71F7C :                     songStart set *
(2)  257/   71F7C :                     
(2)  258/   71F7C :                     	if MOMPASS=1
(2)  259/   71F7C :                     		if SMPS2ASMVer < SourceSMPS2ASM
(2)  260/   71F7C :                     			message "Song at 0x\{songStart} was made for a newer version of SMPS2ASM (this is version \{SMPS2ASMVer}, but song wants at least version \{SourceSMPS2ASM})."
(2)  261/   71F7C :                     		endif
(2)  262/   71F7C :                     	endif
(2)  263/   71F7C :                     
(2)  264/   71F7C :                     	endm
(2)  265/   71F7C :                     
(2)  266/   71F7C :                     smpsHeaderVoiceNull macro
(2)  267/   71F7C :                     	if songStart<>*
(2)  268/   71F7C :                     		fatal "Missing smpsHeaderStartSong"
(2)  269/   71F7C :                     	endif
(2)  270/   71F7C :                     	dc.w	$0000
(2)  271/   71F7C :                     	endm
(2)  272/   71F7C :                     
(2)  273/   71F7C :                     ; Header - Set up Voice Location
(2)  274/   71F7C :                     ; Common to music and SFX
(2)  275/   71F7C :                     smpsHeaderVoice macro loc
(2)  276/   71F7C :                     	if songStart<>*
(2)  277/   71F7C :                     		fatal "Missing smpsHeaderStartSong"
(2)  278/   71F7C :                     	endif
(2)  279/   71F7C :                     	if SonicDriverVer<>1
(2)  280/   71F7C :                     		dc.w	z80_ptr(loc)
(2)  281/   71F7C :                     	else
(2)  282/   71F7C :                     		if (MOMPASS=1)&&(DEFINED(loc))
(2)  283/   71F7C :                     			fatal "Voice banks for Sonic 1 songs must come after the start of the song"
(2)  284/   71F7C :                     		endif
(2)  285/   71F7C :                     		dc.w	loc-songStart
(2)  286/   71F7C :                     	endif
(2)  287/   71F7C :                     	endm
(2)  288/   71F7C :                     
(2)  289/   71F7C :                     ; Header - Set up Voice Location as S3's Universal Voice Bank
(2)  290/   71F7C :                     ; Common to music and SFX
(2)  291/   71F7C :                     smpsHeaderVoiceUVB macro
(2)  292/   71F7C :                     	if songStart<>*
(2)  293/   71F7C :                     		fatal "Missing smpsHeaderStartSong"
(2)  294/   71F7C :                     	endif
(2)  295/   71F7C :                     	if SonicDriverVer>=5
(2)  296/   71F7C :                     		dc.w	z80_ptr(z80_UniVoiceBank)
(2)  297/   71F7C :                     	elseif SonicDriverVer>=3
(2)  298/   71F7C :                     		dc.w	little_endian(z80_UniVoiceBank)
(2)  299/   71F7C :                     	else
(2)  300/   71F7C :                     		fatal "Universal Voice Bank does not exist in Sonic 1 or Sonic 2 drivers"
(2)  301/   71F7C :                     	endif
(2)  302/   71F7C :                     	endm
(2)  303/   71F7C :                     
(2)  304/   71F7C :                     ; Header macros for music (not for SFX)
(2)  305/   71F7C :                     ; Header - Set up Channel Usage
(2)  306/   71F7C :                     smpsHeaderChan macro fm,psg
(2)  307/   71F7C :                     	dc.b	fm,psg
(2)  308/   71F7C :                     	endm
(2)  309/   71F7C :                     
(2)  310/   71F7C :                     ; Header - Set up Tempo
(2)  311/   71F7C :                     smpsHeaderTempo macro div,mod
(2)  312/   71F7C :                     	dc.b	div
(2)  313/   71F7C :                     	convertMainTempoMod mod
(2)  314/   71F7C :                     	endm
(2)  315/   71F7C :                     
(2)  316/   71F7C :                     ; Header - Set up DAC Channel
(2)  317/   71F7C :                     smpsHeaderDAC macro loc,pitch,vol
(2)  318/   71F7C :                     	CheckedChannelPointer loc
(2)  319/   71F7C :                     	if ("pitch"<>"")
(2)  320/   71F7C :                     		dc.b	pitch
(2)  321/   71F7C :                     		if ("vol"<>"")
(2)  322/   71F7C :                     			dc.b	vol
(2)  323/   71F7C :                     		else
(2)  324/   71F7C :                     			dc.b	$00
(2)  325/   71F7C :                     		endif
(2)  326/   71F7C :                     	else
(2)  327/   71F7C :                     		dc.w	$00
(2)  328/   71F7C :                     	endif
(2)  329/   71F7C :                     	endm
(2)  330/   71F7C :                     
(2)  331/   71F7C :                     ; Header - Set up FM Channel
(2)  332/   71F7C :                     smpsHeaderFM macro loc,pitch,vol
(2)  333/   71F7C :                     	CheckedChannelPointer loc
(2)  334/   71F7C :                     	dc.b	pitch,vol
(2)  335/   71F7C :                     	endm
(2)  336/   71F7C :                     
(2)  337/   71F7C :                     ; Header - Set up PSG Channel
(2)  338/   71F7C :                     smpsHeaderPSG macro loc,pitch,vol,mod,voice
(2)  339/   71F7C :                     	CheckedChannelPointer loc
(2)  340/   71F7C :                     	PSGPitchConvert pitch
(2)  341/   71F7C :                     	dc.b	vol
(2)  342/   71F7C :                     	; Frequency envelope
(2)  343/   71F7C :                     	if (SonicDriverVer>=3) && (SourceDriver<3)
(2)  344/   71F7C :                     		; In SMPS 68k Type 1, this byte is skipped and can contain garbage.
(2)  345/   71F7C :                     		; Sonic 2's Oil Ocean Zone and Ending themes set this byte to a non-zero value which
(2)  346/   71F7C :                     		; other drivers may try to process as valid data, so manually force it to 0 here.
(2)  347/   71F7C :                     		dc.b	0
(2)  348/   71F7C :                     	else
(2)  349/   71F7C :                     		if (MOMPASS==1) && (SonicDriverVer<3) && (SourceDriver>=3) && (mod<>0)
(2)  350/   71F7C :                     			message "This track header specifies a frequency envelope, but this driver does not support them."			
(2)  351/   71F7C :                     		endif
(2)  352/   71F7C :                     		dc.b	mod
(2)  353/   71F7C :                     	endif
(2)  354/   71F7C :                     	; Volume envelope
(2)  355/   71F7C :                     	dc.b	voice
(2)  356/   71F7C :                     	endm
(2)  357/   71F7C :                     
(2)  358/   71F7C :                     ; Header macros for SFX (not for music)
(2)  359/   71F7C :                     ; Header - Set up Tempo
(2)  360/   71F7C :                     smpsHeaderTempoSFX macro div
(2)  361/   71F7C :                     	dc.b	div
(2)  362/   71F7C :                     	endm
(2)  363/   71F7C :                     
(2)  364/   71F7C :                     ; Header - Set up Channel Usage
(2)  365/   71F7C :                     smpsHeaderChanSFX macro chan
(2)  366/   71F7C :                     	dc.b	chan
(2)  367/   71F7C :                     	endm
(2)  368/   71F7C :                     
(2)  369/   71F7C :                     ; Header - Set up FM Channel
(2)  370/   71F7C :                     smpsHeaderSFXChannel macro chanid,loc,pitch,vol
(2)  371/   71F7C :                     	if (SonicDriverVer>=3)&&(chanid==cNoise)
(2)  372/   71F7C :                     		fatal "Using channel ID of cNoise ($E0) in Sonic 3 driver is dangerous. Fix the song so that it turns into a noise channel instead."
(2)  373/   71F7C :                     	elseif (SonicDriverVer<3)&&(chanid==cFM6)
(2)  374/   71F7C :                     		fatal "Using channel ID of FM6 ($06) in Sonic 1 or Sonic 2 drivers is unsupported. Change it to another channel."
(2)  375/   71F7C :                     	endif
(2)  376/   71F7C :                     	dc.b	$80,chanid
(2)  377/   71F7C :                     	CheckedChannelPointer loc
(2)  378/   71F7C :                     	if (chanid&$80)<>0
(2)  379/   71F7C :                     		PSGPitchConvert pitch
(2)  380/   71F7C :                     	else
(2)  381/   71F7C :                     		dc.b	pitch
(2)  382/   71F7C :                     	endif
(2)  383/   71F7C :                     	dc.b	vol
(2)  384/   71F7C :                     	endm
(2)  385/   71F7C :                     ; ---------------------------------------------------------------------------
(2)  386/   71F7C :                     ; Co-ord Flag Macros and Equates
(2)  387/   71F7C :                     ; E0xx - Panning, AMS, FMS
(2)  388/   71F7C :                     smpsPan macro direction,amsfms
(2)  389/   71F7C :                     panNone set $00
(2)  390/   71F7C :                     panRight set $40
(2)  391/   71F7C :                     panLeft set $80
(2)  392/   71F7C :                     panCentre set $C0
(2)  393/   71F7C :                     panCenter set $C0 ; silly Americans :U
(2)  394/   71F7C :                     	dc.b $E0,direction+amsfms
(2)  395/   71F7C :                     	endm
(2)  396/   71F7C :                     
(2)  397/   71F7C :                     ; E1xx - Set channel detune to val
(2)  398/   71F7C :                     smpsDetune macro val
(2)  399/   71F7C :                     	dc.b	$E1,val
(2)  400/   71F7C :                     	endm
(2)  401/   71F7C :                     
(2)  402/   71F7C :                     ; E2xx - Used for setting a variable which can be read by the game, for synchonisation. Ristar does this.
(2)  403/   71F7C :                     smpsNop macro val
(2)  404/   71F7C :                     	if (SonicDriverVer>=3) && ((val==$FF) || (val==$29))
(2)  405/   71F7C :                     		warning "Values $FF and $29 are reserved in S3K's driver; use a different value or remove this command."
(2)  406/   71F7C :                     	endif
(2)  407/   71F7C :                     	dc.b	$E2,val
(2)  408/   71F7C :                     	endm
(2)  409/   71F7C :                     
(2)  410/   71F7C :                     ; Return (used after smpsCall)
(2)  411/   71F7C :                     smpsReturn macro val
(2)  412/   71F7C :                     	if SonicDriverVer>=3
(2)  413/   71F7C :                     		dc.b	$F9
(2)  414/   71F7C :                     	else
(2)  415/   71F7C :                     		dc.b	$E3
(2)  416/   71F7C :                     	endif
(2)  417/   71F7C :                     	endm
(2)  418/   71F7C :                     
(2)  419/   71F7C :                     ; Fade in previous song (ie. 1-Up)
(2)  420/   71F7C :                     smpsFade macro val
(2)  421/   71F7C :                     	if SonicDriverVer>=3
(2)  422/   71F7C :                     		dc.b	$E2
(2)  423/   71F7C :                     		if ("val"<>"")
(2)  424/   71F7C :                     			dc.b	val
(2)  425/   71F7C :                     		else
(2)  426/   71F7C :                     			dc.b	$FF
(2)  427/   71F7C :                     		endif
(2)  428/   71F7C :                     		if SourceDriver<3
(2)  429/   71F7C :                     			smpsStop
(2)  430/   71F7C :                     		endif
(2)  431/   71F7C :                     	elseif (SourceDriver>=3) && ("val"<>"") && ("val"<>"$FF")
(2)  432/   71F7C :                     		; This is actually a communication byte, not a fade.
(2)  433/   71F7C :                     		smpsNop	val
(2)  434/   71F7C :                     	else
(2)  435/   71F7C :                     		dc.b	$E4
(2)  436/   71F7C :                     	endif
(2)  437/   71F7C :                     	endm
(2)  438/   71F7C :                     
(2)  439/   71F7C :                     ; E5xx - Set channel tempo divider to xx
(2)  440/   71F7C :                     smpsChanTempoDiv macro val
(2)  441/   71F7C :                     	if SonicDriverVer>=5
(2)  442/   71F7C :                     		; New flag unique to Flamewing's modified S&K driver
(2)  443/   71F7C :                     		dc.b	$FF,$08,val
(2)  444/   71F7C :                     	elseif SonicDriverVer==3
(2)  445/   71F7C :                     		fatal "Coord. Flag to set tempo divider of a single channel does not exist in S3 driver. Use Flamewing's modified S&K sound driver instead."
(2)  446/   71F7C :                     	else
(2)  447/   71F7C :                     		dc.b	$E5,val
(2)  448/   71F7C :                     	endif
(2)  449/   71F7C :                     	endm
(2)  450/   71F7C :                     
(2)  451/   71F7C :                     ; E6xx - Alter Volume by xx
(2)  452/   71F7C :                     smpsAlterVol macro val
(2)  453/   71F7C :                     	dc.b	$E6,val
(2)  454/   71F7C :                     	endm
(2)  455/   71F7C :                     
(2)  456/   71F7C :                     ; E7 - Prevent attack of next note
(2)  457/   71F7C : =$E7                 smpsNoAttack	EQU $E7
(2)  458/   71F7C :                     
(2)  459/   71F7C :                     ; E8xx - Set note fill to xx
(2)  460/   71F7C :                     smpsNoteFill macro val
(2)  461/   71F7C :                     	if (SonicDriverVer>=5)&&(SourceDriver<3)
(2)  462/   71F7C :                     		; Unique to Flamewing's modified driver
(2)  463/   71F7C :                     		dc.b	$FF,$0A,val
(2)  464/   71F7C :                     	else
(2)  465/   71F7C :                     		if (SonicDriverVer>=3)&&(SourceDriver<3)
(2)  466/   71F7C :                     			message "Note fill will not work as intended unless you divide the fill value by the tempo divider or complain to Flamewing to add an appropriate coordination flag for it."
(2)  467/   71F7C :                     		elseif (SonicDriverVer<3)&&(SourceDriver>=3)
(2)  468/   71F7C :                     			message "Note fill will not work as intended unless you multiply the fill value by the tempo divider or complain to Flamewing to add an appropriate coordination flag for it."
(2)  469/   71F7C :                     		endif
(2)  470/   71F7C :                     		dc.b	$E8,val
(2)  471/   71F7C :                     	endif
(2)  472/   71F7C :                     	endm
(2)  473/   71F7C :                     
(2)  474/   71F7C :                     ; Add xx to channel pitch
(2)  475/   71F7C :                     smpsChangeTransposition macro val
(2)  476/   71F7C :                     	if SonicDriverVer>=3
(2)  477/   71F7C :                     		dc.b	$FB,val
(2)  478/   71F7C :                     	else
(2)  479/   71F7C :                     		dc.b	$E9,val
(2)  480/   71F7C :                     	endif
(2)  481/   71F7C :                     	endm
(2)  482/   71F7C :                     
(2)  483/   71F7C :                     ; Set music tempo modifier to xx
(2)  484/   71F7C :                     smpsSetTempoMod macro mod
(2)  485/   71F7C :                     	if SonicDriverVer>=3
(2)  486/   71F7C :                     		dc.b	$FF,$00
(2)  487/   71F7C :                     	else
(2)  488/   71F7C :                     		dc.b	$EA
(2)  489/   71F7C :                     	endif
(2)  490/   71F7C :                     	convertMainTempoMod mod
(2)  491/   71F7C :                     	endm
(2)  492/   71F7C :                     
(2)  493/   71F7C :                     ; Set music tempo divider to xx
(2)  494/   71F7C :                     smpsSetTempoDiv macro val
(2)  495/   71F7C :                     	if SonicDriverVer>=3
(2)  496/   71F7C :                     		dc.b	$FF,$04,val
(2)  497/   71F7C :                     	else
(2)  498/   71F7C :                     		dc.b	$EB,val
(2)  499/   71F7C :                     	endif
(2)  500/   71F7C :                     	endm
(2)  501/   71F7C :                     
(2)  502/   71F7C :                     ; ECxx - Set Volume to xx
(2)  503/   71F7C :                     smpsSetVol macro val
(2)  504/   71F7C :                     	if SonicDriverVer>=3
(2)  505/   71F7C :                     		dc.b	$E4,val
(2)  506/   71F7C :                     	else
(2)  507/   71F7C :                     		fatal "Coord. Flag to set volume (instead of volume attenuation) does not exist in S1 or S2 drivers. Complain to Flamewing to add it."
(2)  508/   71F7C :                     	endif
(2)  509/   71F7C :                     	endm
(2)  510/   71F7C :                     
(2)  511/   71F7C :                     ; Works on all drivers
(2)  512/   71F7C :                     smpsPSGAlterVol macro vol
(2)  513/   71F7C :                     	dc.b	$EC,vol
(2)  514/   71F7C :                     	endm
(2)  515/   71F7C :                     
(2)  516/   71F7C :                     smpsPSGAlterVolS2 macro vol
(2)  517/   71F7C :                     	; Sonic 2's driver allows the FM command to be used on PSG channels, but others do not.
(2)  518/   71F7C :                     	if SonicDriverVer==2
(2)  519/   71F7C :                     		smpsAlterVol vol
(2)  520/   71F7C :                     	else
(2)  521/   71F7C :                     		smpsPSGAlterVol vol
(2)  522/   71F7C :                     	endif
(2)  523/   71F7C :                     	endm
(2)  524/   71F7C :                     
(2)  525/   71F7C :                     ; Clears pushing sound flag in S1
(2)  526/   71F7C :                     smpsClearPush macro
(2)  527/   71F7C :                     	if SonicDriverVer==1
(2)  528/   71F7C :                     		dc.b	$ED
(2)  529/   71F7C :                     	else
(2)  530/   71F7C :                     		fatal "Coord. Flag to clear S1 push block flag does not exist in S2 or S3 drivers. Complain to Flamewing to add it."
(2)  531/   71F7C :                     	endif
(2)  532/   71F7C :                     	endm
(2)  533/   71F7C :                     
(2)  534/   71F7C :                     ; Stops special SFX (S1 only) and restarts overridden music track
(2)  535/   71F7C :                     smpsStopSpecial macro
(2)  536/   71F7C :                     	if SonicDriverVer==1
(2)  537/   71F7C :                     		dc.b	$EE
(2)  538/   71F7C :                     	else
(2)  539/   71F7C :                     		message "Coord. Flag to stop special SFX does not exist in S2 or S3 drivers. Complain to Flamewing to add it. With adequate caution, smpsStop can do this job."
(2)  540/   71F7C :                     		smpsStop
(2)  541/   71F7C :                     	endif
(2)  542/   71F7C :                     	endm
(2)  543/   71F7C :                     
(2)  544/   71F7C :                     ; EFxx[yy] - Set Voice of FM channel to xx; xx < 0 means yy present
(2)  545/   71F7C :                     smpsFMvoice macro voice,songID
(2)  546/   71F7C :                     	if (SonicDriverVer>=3)&&("songID"<>"")
(2)  547/   71F7C :                     		dc.b	$EF,voice|$80,songID+$81
(2)  548/   71F7C :                     	else
(2)  549/   71F7C :                     		dc.b	$EF,voice
(2)  550/   71F7C :                     	endif
(2)  551/   71F7C :                     	endm
(2)  552/   71F7C :                     
(2)  553/   71F7C :                     ; F0wwxxyyzz - Modulation - ww: wait time - xx: modulation speed - yy: change per step - zz: number of steps
(2)  554/   71F7C :                     smpsModSet macro wait,speed,change,step
(2)  555/   71F7C :                     	dc.b	$F0
(2)  556/   71F7C :                     	if (SonicDriverVer>=3)&&(SourceDriver<3)
(2)  557/   71F7C :                     		dc.b	wait+1,speed,change,((step+1) * speed) & $FF
(2)  558/   71F7C :                     	elseif (SonicDriverVer<3)&&(SourceDriver>=3)
(2)  559/   71F7C :                     		dc.b	wait-1,speed,change,conv0To256(step)/conv0To256(speed)-1
(2)  560/   71F7C :                     	else
(2)  561/   71F7C :                     		dc.b	wait,speed,change,step
(2)  562/   71F7C :                     	endif
(2)  563/   71F7C :                     	;dc.b	speed,change,step
(2)  564/   71F7C :                     	endm
(2)  565/   71F7C :                     
(2)  566/   71F7C :                     ; Turn on Modulation
(2)  567/   71F7C :                     smpsModOn macro type
(2)  568/   71F7C :                     	if SonicDriverVer>=3
(2)  569/   71F7C :                     		if "type"<>""
(2)  570/   71F7C :                     			dc.b	$F4,type
(2)  571/   71F7C :                     		else
(2)  572/   71F7C :                     			dc.b	$F4,$80
(2)  573/   71F7C :                     		endif
(2)  574/   71F7C :                     	else
(2)  575/   71F7C :                     		dc.b	$F1
(2)  576/   71F7C :                     	endif
(2)  577/   71F7C :                     	endm
(2)  578/   71F7C :                     
(2)  579/   71F7C :                     ; F2 - End of channel
(2)  580/   71F7C :                     smpsStop macro
(2)  581/   71F7C :                     	dc.b	$F2
(2)  582/   71F7C :                     	endm
(2)  583/   71F7C :                     
(2)  584/   71F7C :                     ; F3xx - PSG waveform to xx
(2)  585/   71F7C :                     smpsPSGform macro form
(2)  586/   71F7C :                     	dc.b	$F3,form
(2)  587/   71F7C :                     	endm
(2)  588/   71F7C :                     
(2)  589/   71F7C :                     ; Turn off Modulation
(2)  590/   71F7C :                     smpsModOff macro
(2)  591/   71F7C :                     	if SonicDriverVer>=3
(2)  592/   71F7C :                     		dc.b	$FA
(2)  593/   71F7C :                     	else
(2)  594/   71F7C :                     		dc.b	$F4
(2)  595/   71F7C :                     	endif
(2)  596/   71F7C :                     	endm
(2)  597/   71F7C :                     
(2)  598/   71F7C :                     ; F5xx - PSG voice to xx
(2)  599/   71F7C :                     smpsPSGvoice macro voice
(2)  600/   71F7C :                     	dc.b	$F5,voice
(2)  601/   71F7C :                     	endm
(2)  602/   71F7C :                     
(2)  603/   71F7C :                     ; F6xxxx - Jump to xxxx
(2)  604/   71F7C :                     smpsJump macro loc
(2)  605/   71F7C :                     	dc.b	$F6
(2)  606/   71F7C :                     	if SonicDriverVer<>1
(2)  607/   71F7C :                     		dc.w	z80_ptr(loc)
(2)  608/   71F7C :                     	else
(2)  609/   71F7C :                     		dc.w	loc-*-1
(2)  610/   71F7C :                     	endif
(2)  611/   71F7C :                     	endm
(2)  612/   71F7C :                     
(2)  613/   71F7C :                     ; F7xxyyzzzz - Loop back to zzzz yy times, xx being the loop index for loop recursion fixing
(2)  614/   71F7C :                     smpsLoop macro index,loops,loc
(2)  615/   71F7C :                     	dc.b	$F7
(2)  616/   71F7C :                     	dc.b	index,loops
(2)  617/   71F7C :                     	if SonicDriverVer<>1
(2)  618/   71F7C :                     		dc.w	z80_ptr(loc)
(2)  619/   71F7C :                     	else
(2)  620/   71F7C :                     		dc.w	loc-*-1
(2)  621/   71F7C :                     	endif
(2)  622/   71F7C :                     	endm
(2)  623/   71F7C :                     
(2)  624/   71F7C :                     ; F8xxxx - Call pattern at xxxx, saving return point
(2)  625/   71F7C :                     smpsCall macro loc
(2)  626/   71F7C :                     	dc.b	$F8
(2)  627/   71F7C :                     	if SonicDriverVer<>1
(2)  628/   71F7C :                     		dc.w	z80_ptr(loc)
(2)  629/   71F7C :                     	else
(2)  630/   71F7C :                     		dc.w	loc-*-1
(2)  631/   71F7C :                     	endif
(2)  632/   71F7C :                     	endm
(2)  633/   71F7C :                     ; ---------------------------------------------------------------------------
(2)  634/   71F7C :                     ; Alter Volume
(2)  635/   71F7C :                     smpsFMAlterVol macro val1,val2
(2)  636/   71F7C :                     	if ("val2"<>"")
(2)  637/   71F7C :                     		; S3K's nerfed 'PSG & FM volume' command with broken PSG support.
(2)  638/   71F7C :                     		; The first value is completely unused, while the second is for FM tracks.
(2)  639/   71F7C :                     		if (SonicDriverVer>=3)
(2)  640/   71F7C :                     			dc.b	$E5,val1,val2
(2)  641/   71F7C :                     		else
(2)  642/   71F7C :                     			dc.b	$E6,val2
(2)  643/   71F7C :                     		endif
(2)  644/   71F7C :                     	else
(2)  645/   71F7C :                     		; Normal, sane command.
(2)  646/   71F7C :                     		dc.b	$E6,val1
(2)  647/   71F7C :                     	endif
(2)  648/   71F7C :                     	endm
(2)  649/   71F7C :                     
(2)  650/   71F7C :                     ; S3/S&K/S3D-only coordination flags
(2)  755/   71F7C :                     ; ---------------------------------------------------------------------------
(2)  756/   71F7C :                     ; S1/S2 only coordination flag
(2)  757/   71F7C :                     ; Sets D1L to maximum volume (minimum attenuation) and RR to maximum for operators 3 and 4 of FM1
(2)  758/   71F7C :                     smpsMaxRelRate macro
(2)  759/   71F7C :                     	if SonicDriverVer>=3
(2)  760/   71F7C :                     		; Emulate it in S3/S&K/S3D driver
(2)  761/   71F7C :                     		smpsFMICommand $88,$0F
(2)  762/   71F7C :                     		smpsFMICommand $8C,$0F
(2)  763/   71F7C :                     	else
(2)  764/   71F7C :                     		dc.b	$F9
(2)  765/   71F7C :                     	endif
(2)  766/   71F7C :                     	endm
(2)  767/   71F7C :                     ; ---------------------------------------------------------------------------
(2)  768/   71F7C :                     ; Backwards compatibility
(2)  769/   71F7C :                     smpsAlterNote macro
(2)  770/   71F7C :                     	smpsDetune	ALLARGS
(2)  771/   71F7C :                     	endm
(2)  772/   71F7C :                     
(2)  773/   71F7C :                     smpsAlterPitch macro
(2)  774/   71F7C :                     	smpsChangeTransposition	ALLARGS
(2)  775/   71F7C :                     	endm
(2)  776/   71F7C :                     
(2)  777/   71F7C :                     smpsFMFlutter macro
(2)  778/   71F7C :                     	smpsFMVolEnv	ALLARGS
(2)  779/   71F7C :                     	endm
(2)  780/   71F7C :                     
(2)  781/   71F7C :                     smpsWeirdD1LRR macro
(2)  782/   71F7C :                     	smpsMaxRelRate ALLARGS
(2)  783/   71F7C :                     	endm
(2)  784/   71F7C :                     
(2)  785/   71F7C :                     smpsSetvoice macro
(2)  786/   71F7C :                     	smpsFMvoice ALLARGS
(2)  787/   71F7C :                     	endm
(2)  788/   71F7C :                     ; ---------------------------------------------------------------------------
(2)  789/   71F7C :                     ; Macros for FM instruments
(2)  790/   71F7C :                     ; Voices - Feedback
(2)  791/   71F7C :                     smpsVcFeedback macro val
(2)  792/   71F7C :                     vcFeedback eval val
(2)  793/   71F7C :                     	endm
(2)  794/   71F7C :                     
(2)  795/   71F7C :                     ; Voices - Algorithm
(2)  796/   71F7C :                     smpsVcAlgorithm macro val
(2)  797/   71F7C :                     vcAlgorithm eval val
(2)  798/   71F7C :                     	endm
(2)  799/   71F7C :                     
(2)  800/   71F7C :                     smpsVcUnusedBits macro val,d1r1,d1r2,d1r3,d1r4
(2)  801/   71F7C :                     vcUnusedBits eval val
(2)  802/   71F7C :                     	if ("d1r1"<>"")&&("d1r2"<>"")&&("d1r3"<>"")&&("d1r4"<>"")
(2)  803/   71F7C :                     		eval vcD1R1Unk,d1r1<<5
(2)  804/   71F7C :                     		eval vcD1R2Unk,d1r2<<5
(2)  805/   71F7C :                     		eval vcD1R3Unk,d1r3<<5
(2)  806/   71F7C :                     		eval vcD1R4Unk,d1r4<<5
(2)  807/   71F7C :                     	else
(2)  808/   71F7C :                     		eval vcD1R1Unk,0
(2)  809/   71F7C :                     		eval vcD1R2Unk,0
(2)  810/   71F7C :                     		eval vcD1R3Unk,0
(2)  811/   71F7C :                     		eval vcD1R4Unk,0
(2)  812/   71F7C :                     	endif
(2)  813/   71F7C :                     	endm
(2)  814/   71F7C :                     
(2)  815/   71F7C :                     ; Voices - Detune
(2)  816/   71F7C :                     smpsVcDetune macro op1,op2,op3,op4
(2)  817/   71F7C :                     	eval vcDT1,op1
(2)  818/   71F7C :                     	eval vcDT2,op2
(2)  819/   71F7C :                     	eval vcDT3,op3
(2)  820/   71F7C :                     	eval vcDT4,op4
(2)  821/   71F7C :                     	endm
(2)  822/   71F7C :                     
(2)  823/   71F7C :                     ; Voices - Coarse-Frequency
(2)  824/   71F7C :                     smpsVcCoarseFreq macro op1,op2,op3,op4
(2)  825/   71F7C :                     	eval vcCF1,op1
(2)  826/   71F7C :                     	eval vcCF2,op2
(2)  827/   71F7C :                     	eval vcCF3,op3
(2)  828/   71F7C :                     	eval vcCF4,op4
(2)  829/   71F7C :                     	endm
(2)  830/   71F7C :                     
(2)  831/   71F7C :                     ; Voices - Rate Scale
(2)  832/   71F7C :                     smpsVcRateScale macro op1,op2,op3,op4
(2)  833/   71F7C :                     	eval vcRS1,op1
(2)  834/   71F7C :                     	eval vcRS2,op2
(2)  835/   71F7C :                     	eval vcRS3,op3
(2)  836/   71F7C :                     	eval vcRS4,op4
(2)  837/   71F7C :                     	endm
(2)  838/   71F7C :                     
(2)  839/   71F7C :                     ; Voices - Attack Rate
(2)  840/   71F7C :                     smpsVcAttackRate macro op1,op2,op3,op4
(2)  841/   71F7C :                     	eval vcAR1,op1
(2)  842/   71F7C :                     	eval vcAR2,op2
(2)  843/   71F7C :                     	eval vcAR3,op3
(2)  844/   71F7C :                     	eval vcAR4,op4
(2)  845/   71F7C :                     	endm
(2)  846/   71F7C :                     
(2)  847/   71F7C :                     ; Voices - Amplitude Modulation
(2)  848/   71F7C :                     ; The original SMPS2ASM erroneously assumed the 6th and 7th bits
(2)  849/   71F7C :                     ; were the Amplitude Modulation.
(2)  850/   71F7C :                     ; According to several docs, however, it's actually the high bit.
(2)  851/   71F7C :                     smpsVcAmpMod macro op1,op2,op3,op4
(2)  852/   71F7C :                     	if SourceSMPS2ASM==0
(2)  853/   71F7C :                     		eval vcAM1,op1<<5
(2)  854/   71F7C :                     		eval vcAM2,op2<<5
(2)  855/   71F7C :                     		eval vcAM3,op3<<5
(2)  856/   71F7C :                     		eval vcAM4,op4<<5
(2)  857/   71F7C :                     	else
(2)  858/   71F7C :                     		eval vcAM1,op1<<7
(2)  859/   71F7C :                     		eval vcAM2,op2<<7
(2)  860/   71F7C :                     		eval vcAM3,op3<<7
(2)  861/   71F7C :                     		eval vcAM4,op4<<7
(2)  862/   71F7C :                     	endif
(2)  863/   71F7C :                     	endm
(2)  864/   71F7C :                     
(2)  865/   71F7C :                     ; Voices - First Decay Rate
(2)  866/   71F7C :                     smpsVcDecayRate1 macro op1,op2,op3,op4
(2)  867/   71F7C :                     	eval vcD1R1,op1
(2)  868/   71F7C :                     	eval vcD1R2,op2
(2)  869/   71F7C :                     	eval vcD1R3,op3
(2)  870/   71F7C :                     	eval vcD1R4,op4
(2)  871/   71F7C :                     	endm
(2)  872/   71F7C :                     
(2)  873/   71F7C :                     ; Voices - Second Decay Rate
(2)  874/   71F7C :                     smpsVcDecayRate2 macro op1,op2,op3,op4
(2)  875/   71F7C :                     	eval vcD2R1,op1
(2)  876/   71F7C :                     	eval vcD2R2,op2
(2)  877/   71F7C :                     	eval vcD2R3,op3
(2)  878/   71F7C :                     	eval vcD2R4,op4
(2)  879/   71F7C :                     	endm
(2)  880/   71F7C :                     
(2)  881/   71F7C :                     ; Voices - Decay Level
(2)  882/   71F7C :                     smpsVcDecayLevel macro op1,op2,op3,op4
(2)  883/   71F7C :                     	eval vcDL1,op1
(2)  884/   71F7C :                     	eval vcDL2,op2
(2)  885/   71F7C :                     	eval vcDL3,op3
(2)  886/   71F7C :                     	eval vcDL4,op4
(2)  887/   71F7C :                     	endm
(2)  888/   71F7C :                     
(2)  889/   71F7C :                     ; Voices - Release Rate
(2)  890/   71F7C :                     smpsVcReleaseRate macro op1,op2,op3,op4
(2)  891/   71F7C :                     	eval vcRR1,op1
(2)  892/   71F7C :                     	eval vcRR2,op2
(2)  893/   71F7C :                     	eval vcRR3,op3
(2)  894/   71F7C :                     	eval vcRR4,op4
(2)  895/   71F7C :                     	endm
(2)  896/   71F7C :                     
(2)  897/   71F7C :                     smpsNotZ80 function cpu,(cpu<>128)&&(cpu<>32988)
(2)  898/   71F7C :                     
(2)  899/   71F7C :                     smpsDcb macro
(2)  900/   71F7C :                     		if smpsNotZ80(MOMCPU)
(2)  901/   71F7C :                     			dc.b ALLARGS
(2)  902/   71F7C :                     		else
(2)  903/   71F7C :                     			db ALLARGS
(2)  904/   71F7C :                     		endif
(2)  905/   71F7C :                     	endm
(2)  906/   71F7C :                     
(2)  907/   71F7C :                     ; Voices - Total Level
(2)  908/   71F7C :                     ; The original SMPS2ASM decides TL high bits automatically,
(2)  909/   71F7C :                     ; but later versions leave it up to the user.
(2)  910/   71F7C :                     ; Alternatively, if we're converting an SMPS 68k song to SMPS Z80,
(2)  911/   71F7C :                     ; then we *want* the TL bits to match the algorithm, because SMPS 68k
(2)  912/   71F7C :                     ; prefers the algorithm over the TL bits, ignoring the latter, while
(2)  913/   71F7C :                     ; SMPS Z80 does the opposite.
(2)  914/   71F7C :                     ; Unfortunately, there's nothing we can do if we're trying to convert
(2)  915/   71F7C :                     ; an SMPS Z80 song to SMPS 68k. It will ignore the bits no matter
(2)  916/   71F7C :                     ; what we do, so we just print a warning.
(2)  917/   71F7C :                     smpsVcTotalLevel macro op1,op2,op3,op4
(2)  918/   71F7C :                     	eval vcTL1,op1
(2)  919/   71F7C :                     	eval vcTL2,op2
(2)  920/   71F7C :                     	eval vcTL3,op3
(2)  921/   71F7C :                     	eval vcTL4,op4
(2)  922/   71F7C :                     	smpsDcb	(vcUnusedBits<<6)+(vcFeedback<<3)+vcAlgorithm
(2)  923/   71F7C :                     ;   0     1     2     3     4     5     6     7
(2)  924/   71F7C :                     ;%1000,%1000,%1000,%1000,%1010,%1110,%1110,%1111
(2)  925/   71F7C :                     	if SourceSMPS2ASM==0
(2)  926/   71F7C :                     		eval vcTLMask4,((vcAlgorithm==7)<<7)
(2)  927/   71F7C :                     		eval vcTLMask3,((vcAlgorithm>=4)<<7)
(2)  928/   71F7C :                     		eval vcTLMask2,((vcAlgorithm>=5)<<7)
(2)  929/   71F7C :                     		eval vcTLMask1,128
(2)  930/   71F7C :                     	else
(2)  931/   71F7C :                     		eval vcTLMask4,0
(2)  932/   71F7C :                     		eval vcTLMask3,0
(2)  933/   71F7C :                     		eval vcTLMask2,0
(2)  934/   71F7C :                     		eval vcTLMask1,0
(2)  935/   71F7C :                     	endif
(2)  936/   71F7C :                     
(2)  937/   71F7C :                     	if (SonicDriverVer>=3)&&(SourceDriver<3)
(2)  938/   71F7C :                     		eval vcTLMask4,((vcAlgorithm==7)<<7)
(2)  939/   71F7C :                     		eval vcTLMask3,((vcAlgorithm>=4)<<7)
(2)  940/   71F7C :                     		eval vcTLMask2,((vcAlgorithm>=5)<<7)
(2)  941/   71F7C :                     		eval vcTLMask1,128
(2)  942/   71F7C :                     		eval vcTL1,vcTL1&127
(2)  943/   71F7C :                     		eval vcTL2,vcTL2&127
(2)  944/   71F7C :                     		eval vcTL3,vcTL3&127
(2)  945/   71F7C :                     		eval vcTL4,vcTL4&127
(2)  946/   71F7C :                     	elseif (SonicDriverVer<3)&&(SourceDriver>=3)&&((((vcTL1|vcTLMask1)&128)<>128)||(((vcTL2|vcTLMask2)&128)<>((vcAlgorithm>=5)<<7))||(((vcTL3|vcTLMask3)&128)<>((vcAlgorithm>=4)<<7))||(((vcTL4|vcTLMask4)&128)<>((vcAlgorithm==7)<<7)))
(2)  947/   71F7C :                     		if MOMPASS=1
(2)  948/   71F7C :                     			message "Voice at 0x\{*} has TL bits that do not match its algorithm setting. This voice will not work in S1/S2 drivers."
(2)  949/   71F7C :                     		endif
(2)  950/   71F7C :                     	endif
(2)  951/   71F7C :                     
(2)  952/   71F7C :                     	if SonicDriverVer==2
(2)  953/   71F7C :                     		smpsDcb	(vcDT4<<4)+vcCF4       ,(vcDT2<<4)+vcCF2       ,(vcDT3<<4)+vcCF3       ,(vcDT1<<4)+vcCF1
(2)  954/   71F7C :                     		smpsDcb	(vcRS4<<6)+vcAR4       ,(vcRS2<<6)+vcAR2       ,(vcRS3<<6)+vcAR3       ,(vcRS1<<6)+vcAR1
(2)  955/   71F7C :                     		smpsDcb	vcAM4|vcD1R4|vcD1R4Unk ,vcAM2|vcD1R2|vcD1R2Unk ,vcAM3|vcD1R3|vcD1R3Unk ,vcAM1|vcD1R1|vcD1R1Unk
(2)  956/   71F7C :                     		smpsDcb	vcD2R4                 ,vcD2R2                 ,vcD2R3                 ,vcD2R1
(2)  957/   71F7C :                     		smpsDcb	(vcDL4<<4)+vcRR4       ,(vcDL2<<4)+vcRR2       ,(vcDL3<<4)+vcRR3       ,(vcDL1<<4)+vcRR1
(2)  958/   71F7C :                     		smpsDcb	vcTL4|vcTLMask4        ,vcTL2|vcTLMask2        ,vcTL3|vcTLMask3        ,vcTL1|vcTLMask1
(2)  959/   71F7C :                     	else
(2)  960/   71F7C :                     		smpsDcb	(vcDT4<<4)+vcCF4       ,(vcDT3<<4)+vcCF3       ,(vcDT2<<4)+vcCF2       ,(vcDT1<<4)+vcCF1
(2)  961/   71F7C :                     		smpsDcb	(vcRS4<<6)+vcAR4       ,(vcRS3<<6)+vcAR3       ,(vcRS2<<6)+vcAR2       ,(vcRS1<<6)+vcAR1
(2)  962/   71F7C :                     		smpsDcb	vcAM4|vcD1R4|vcD1R4Unk ,vcAM3|vcD1R3|vcD1R3Unk ,vcAM2|vcD1R2|vcD1R2Unk ,vcAM1|vcD1R1|vcD1R1Unk
(2)  963/   71F7C :                     		smpsDcb	vcD2R4                 ,vcD2R3                 ,vcD2R2                 ,vcD2R1
(2)  964/   71F7C :                     		smpsDcb	(vcDL4<<4)+vcRR4       ,(vcDL3<<4)+vcRR3       ,(vcDL2<<4)+vcRR2       ,(vcDL1<<4)+vcRR1
(2)  965/   71F7C :                     		smpsDcb	vcTL4|vcTLMask4        ,vcTL3|vcTLMask3        ,vcTL2|vcTLMask2        ,vcTL1|vcTLMask1
(2)  966/   71F7C :                     	endif
(2)  967/   71F7C :                     	endm
