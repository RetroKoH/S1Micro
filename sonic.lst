    5021/    7074 : E44D                		lsr.w	#2,d5
    5022/    7076 : D845                		add.w	d5,d4
    5023/    7078 : 7002                		moveq	#2,d0
    5024/    707A : 4840                		swap	d0
    5025/    707C : 3004                		move.w	d4,d0
    5026/    707E : 4E75                		rts	
