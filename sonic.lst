    3475/    4936 :                     SSBGData:	macro time,anim,vram,index,flag1,flag2
    3476/    4936 :                     		dc.b	(time), (anim), ((vram)*tile_size)>>13
    3477/    4936 :                     	if flag1
    3478/    4936 :                     		dc.b	(index)|$80|(flag2)
    3479/    4936 :                     	else
    3480/    4936 :                     		dc.b	(index)*12
    3481/    4936 :                     	endif
    3482/    4936 :                     		endm
